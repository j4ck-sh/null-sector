
---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  contentType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = "NULL SECTOR",
  description =
    "An independent cybersecurity and digital-forensics portfolio documenting learning, technical research, and field notes.",
  contentType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteName = "NULL SECTOR";

const basePath = import.meta.env.BASE_URL;

function withBase(path: string): string {
  const base = basePath.endsWith("/")
    ? basePath
    : `${basePath}/`;

  const relativePath = path.replace(/^\/+/, "");

  return `${base}${relativePath}`;
}

function normalizeTitle(value: string): string {
  const trimmed = value.trim();

  if (!trimmed || trimmed.toLowerCase() === siteName.toLowerCase()) {
    return siteName;
  }

  const withoutSuffix = trimmed
    .replace(/\s*\|\s*(?:NULL SECTOR|Null Sector)\s*$/i, "")
    .trim();

  return withoutSuffix
    ? `${withoutSuffix} | ${siteName}`
    : siteName;
}

const pageTitle = normalizeTitle(title);

const pathname =
  Astro.url.pathname.replace(/\/+$/, "") || "/";

const navigation = [
  { label: "Home", href: withBase("/") },
  { label: "Learning", href: withBase("/learning/") },
  { label: "Research", href: withBase("/research/") },
  { label: "Field Notes", href: withBase("/field-notes/") },
  { label: "About", href: withBase("/about/") },
];

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, "") || "/";

  if (target === "/") {
    return pathname === "/";
  }

  return pathname === target || pathname.startsWith(`${target}/`);
}

const year = new Date().getFullYear();

const configuredSite = Astro.site;

const canonicalUrl = configuredSite
  ? new URL(Astro.url.pathname, configuredSite).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="theme-color" content="#0b1110" />
    <meta name="color-scheme" content="dark" />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/png"
      href={withBase("/favicon.png")}
    />

    <meta name="description" content={description} />
    <meta name="author" content="NULL SECTOR" />

    <title>{pageTitle}</title>

    {canonicalUrl && (
      <link rel="canonical" href={canonicalUrl} />
    )}

    <meta property="og:type" content={contentType} />

{contentType === "article" && publishedTime && (
  <meta
    property="article:published_time"
    content={publishedTime}
  />
)}

{contentType === "article" && modifiedTime && (
  <meta
    property="article:modified_time"
    content={modifiedTime}
  />
)}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content={description}
    />

    {canonicalUrl && (
      <meta property="og:url" content={canonicalUrl} />
    )}

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content={description}
    />
  </head>

  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <div class="site-shell">
      <header
        class="site-header"
        data-site-header
      >
        <div class="container header-inner">
          <a
            class="site-brand"
            href={withBase("/")}
            aria-label="NULL SECTOR — Home"
          >
            <span
              class="brand-mark"
              aria-hidden="true"
            >
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </span>

            <span class="brand-name">
              NULL<span class="brand-accent">_</span>SECTOR
            </span>
          </a>

          <nav
            class="desktop-nav"
            aria-label="Primary navigation"
          >
            {
              navigation.map((item, index) => (
                <a
                  href={item.href}
                  class:list={[
                    "nav-link",
                    { active: isActive(item.href) },
                  ]}
                  aria-current={
                    isActive(item.href)
                      ? "page"
                      : undefined
                  }
                >
                  <span
                    class="nav-index"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span>{item.label}</span>
                </a>
              ))
            }
          </nav>

          <div class="header-actions">
            <span
              class="system-status"
              aria-label="NULL SECTOR"
            >
              <span
                class="status-dot"
                aria-hidden="true"
              ></span>

              <span>SYS.ONLINE</span>
            </span>

            <button
              class="menu-toggle"
              type="button"
              aria-label="Open navigation"
              aria-controls="mobile-navigation"
              aria-expanded="false"
              data-menu-toggle
            >
              <span></span>
              <span></span>
              <span></span>
            </button>
          </div>
        </div>

        <nav
          class="mobile-nav"
          id="mobile-navigation"
          aria-label="Mobile navigation"
          hidden
          data-mobile-nav
        >
          <div class="container mobile-nav-inner">
            {
              navigation.map((item, index) => (
                <a
                  href={item.href}
                  class:list={[
                    "mobile-nav-link",
                    { active: isActive(item.href) },
                  ]}
                  aria-current={
                    isActive(item.href)
                      ? "page"
                      : undefined
                  }
                >
                  <span
                    class="mobile-nav-index"
                    aria-hidden="true"
                  >
                    {String(index + 1).padStart(2, "0")}
                  </span>

                  <span>{item.label}</span>

                  <span
                    class="mobile-nav-arrow"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              ))
            }
          </div>
        </nav>
      </header>

      <div class="site-content">
  <slot />
</div>

      <footer class="site-footer">
        <div class="container">
          <div class="footer-top">
            <div class="footer-identity">
              <span class="footer-label">
                [ NS / INDEPENDENT LEARNING & RESEARCH ]
              </span>

              <p class="footer-title">
                NULL_SECTOR
              </p>

              <p class="footer-description">
                Cybersecurity, digital forensics,
                technical research, and continuous
                learning. Documenting methods,
                evidence, and progress.
              </p>
            </div>

            <div class="footer-directory">
              <span class="footer-label">
                [ DIRECTORY ]
              </span>

              <nav aria-label="Footer navigation">
                {
                  navigation.map((item) => (
                    <a
                      href={item.href}
                      aria-current={
                        isActive(item.href)
                          ? "page"
                          : undefined
                      }
                    >
                      {item.label}
                    </a>
                  ))
                }
              </nav>
            </div>
          </div>

          <div class="footer-bottom">
            <span>
              © {year} NULL SECTOR
            </span>

            <span class="footer-signoff">
              END OF TRANSMISSION
              <span aria-hidden="true">_</span>
            </span>
          </div>
        </div>
      </footer>
    </div>

    <script>
      function setupMobileNavigation() {
        const header =
          document.querySelector<HTMLElement>(
            "[data-site-header]"
          );

        const toggle =
          document.querySelector<HTMLButtonElement>(
            "[data-menu-toggle]"
          );

        const mobileNav =
          document.querySelector<HTMLElement>(
            "[data-mobile-nav]"
          );

        if (!header || !toggle || !mobileNav) {
          return;
        }

        if (toggle.dataset.initialized === "true") {
          return;
        }

        toggle.dataset.initialized = "true";

        const desktopQuery = window.matchMedia(
          "(min-width: 961px)"
        );

        function isOpen(): boolean {
          return (
            toggle?.getAttribute("aria-expanded") ===
            "true"
          );
        }

        function setMenuOpen(
          open: boolean,
          restoreFocus = false
        ) {
          if (!toggle || !mobileNav) {
            return;
          }

          toggle.setAttribute(
            "aria-expanded",
            String(open)
          );

          toggle.setAttribute(
            "aria-label",
            open
              ? "Close navigation"
              : "Open navigation"
          );

          mobileNav.hidden = !open;

          document.body.classList.toggle(
            "menu-open",
            open
          );

          if (
            !open &&
            restoreFocus &&
            !desktopQuery.matches
          ) {
            toggle.focus();
          }
        }

        function onToggleClick() {
          setMenuOpen(!isOpen());
        }

        function onDocumentKeydown(
          event: KeyboardEvent
        ) {
          if (!isOpen()) {
            return;
          }

          if (event.key === "Escape") {
            event.preventDefault();

            setMenuOpen(false, true);
            return;
          }

          if (event.key !== "Tab") {
            return;
          }

          const focusable = [
            toggle!,
            ...Array.from(
              mobileNav!.querySelectorAll<HTMLAnchorElement>(
                "a[href]"
              )
            ),
          ];

          const first = focusable[0];
          const last =
            focusable[focusable.length - 1];

          if (!first || !last) {
            return;
          }

          if (
            event.shiftKey &&
            document.activeElement === first
          ) {
            event.preventDefault();
            last.focus();
          } else if (
            !event.shiftKey &&
            document.activeElement === last
          ) {
            event.preventDefault();
            first.focus();
          }
        }

        function onDocumentClick(
          event: MouseEvent
        ) {
          if (!isOpen()) {
            return;
          }

          if (
            event.target instanceof Node &&
            !header!.contains(event.target)
          ) {
            setMenuOpen(false);
          }
        }

        function onDesktopChange(
          event: MediaQueryListEvent
        ) {
          if (event.matches) {
            setMenuOpen(false);
          }
        }

        function onMobileLinkClick() {
          setMenuOpen(false);
        }

        toggle.addEventListener(
          "click",
          onToggleClick
        );

        mobileNav
          .querySelectorAll("a")
          .forEach((link) => {
            link.addEventListener(
              "click",
              onMobileLinkClick
            );
          });

        document.addEventListener(
          "keydown",
          onDocumentKeydown
        );

        document.addEventListener(
          "click",
          onDocumentClick
        );

        desktopQuery.addEventListener(
          "change",
          onDesktopChange
        );

        document.addEventListener(
          "astro:before-swap",
          () => {
            setMenuOpen(false);

            toggle.removeEventListener(
              "click",
              onToggleClick
            );

            document.removeEventListener(
              "keydown",
              onDocumentKeydown
            );

            document.removeEventListener(
              "click",
              onDocumentClick
            );

            desktopQuery.removeEventListener(
              "change",
              onDesktopChange
            );

            mobileNav
              .querySelectorAll("a")
              .forEach((link) => {
                link.removeEventListener(
                  "click",
                  onMobileLinkClick
                );
              });

            delete toggle.dataset.initialized;
          },
          { once: true }
        );
      }

      setupMobileNavigation();

      document.addEventListener(
        "astro:after-swap",
        setupMobileNavigation
      );
    </script>
  </body>
</html>

<style>
  .site-shell {
    display: flex;
    min-height: 100vh;
    min-height: 100dvh;
    flex-direction: column;
  }

  .site-content {
    flex: 1 0 auto;
    min-width: 0;
  }

  .site-header {
    position: relative;
    z-index: 100;

    border-bottom: 1px solid var(--border);
    background: rgba(11, 17, 16, 0.97);
  }

  .header-inner {
    display: flex;
    min-height: 82px;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-brand {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.85rem;

    color: var(--text);
    text-decoration: none;
  }

  .site-brand:hover {
    color: var(--text);
  }

  .brand-mark {
    display: grid;
    width: 28px;
    height: 28px;

    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 3px;

    transform: rotate(-8deg);

    transition:
      transform var(--transition-normal);
  }

  .site-brand:hover .brand-mark {
    transform: rotate(0deg);
  }

  .brand-mark span {
    background: var(--green);
  }

  .brand-mark span:nth-child(2) {
    background: var(--blue);
  }

  .brand-mark span:nth-child(3) {
    background: var(--green-dark);
  }

  .brand-mark span:nth-child(4) {
    border: 2px solid var(--green);
    background: transparent;
  }

  .brand-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  .brand-accent {
    color: var(--green);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(
      0.75rem,
      1.5vw,
      1.75rem
    );
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;

    padding: 0.5rem 0;

    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-decoration: none;
    white-space: nowrap;

    transition:
      color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--green);
  }

  .nav-link.active::after {
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;

    height: 1px;
    background: var(--green);
    content: "";
  }

  .nav-index {
    color: var(--text-dim);
    font-size: 0.6rem;
  }

  .nav-link.active .nav-index {
    color: var(--green-dark);
  }

  .header-actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.25rem;
  }

  .system-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .status-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    background: var(--green);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 5px;

    padding: 0;

    border: 1px solid var(--border);
    border-radius: 0;
    background: var(--bg-panel);

    color: var(--green);
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: var(--green);
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;

    transition:
      transform var(--transition-fast),
      opacity var(--transition-fast);
  }

  .menu-toggle[aria-expanded="true"]
  span:first-child {
    transform:
      translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"]
  span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"]
  span:last-child {
    transform:
      translateY(-7px) rotate(-45deg);
  }

  .mobile-nav[hidden] {
    display: none !important;
  }

  .mobile-nav {
    background: var(--bg-raised);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .mobile-nav-inner {
    padding-block: 0.75rem 1.25rem;
  }

  .mobile-nav-link {
    display: flex;
    min-height: 54px;
    align-items: center;
    gap: 1rem;

    padding: 0.75rem 0;

    border-bottom: 1px solid var(--border);

    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.active {
    color: var(--green);
  }

  .mobile-nav-link.active {
    border-bottom-color:
      var(--green-dark);
  }

  .mobile-nav-index {
    color: var(--text-dim);
    font-size: 0.7rem;
  }

  .mobile-nav-arrow {
    margin-left: auto;
    color: var(--blue);
  }

  .site-footer {
    margin-top: auto;
    padding-top: 4rem;

    border-top: 1px solid var(--border);
    background: var(--bg-inset);
  }

  .footer-top {
    display: grid;
    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(0, 1fr);
    gap: 4rem;

    padding-bottom: 4rem;
  }

  .footer-label {
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .footer-title {
    margin: 1rem 0 0.75rem;

    color: var(--text);
    font-family: var(--font-mono);
    font-size: clamp(
      1.5rem,
      4vw,
      2.5rem
    );
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 1.2;
  }

  .footer-description {
    max-width: 430px;
    margin: 0;

    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.8;
  }

  .footer-directory nav {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
  }

  .footer-directory a {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
  }

  .footer-directory a:hover,
  .footer-directory a[aria-current="page"] {
    color: var(--green);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;

    padding: 1.25rem 0;

    border-top: 1px solid var(--border);

    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
  }

  .footer-signoff {
    color: var(--blue);
  }

  .footer-signoff span {
    color: var(--green);
  }

  .site-brand:focus-visible,
  .nav-link:focus-visible,
  .menu-toggle:focus-visible,
  .mobile-nav-link:focus-visible,
  .footer-directory a:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 5px;
  }

  @media (max-width: 1100px) {
    .system-status {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .header-inner {
      min-height: 72px;
    }

    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .system-status {
      display: inline-flex;
    }
  }

  @media (min-width: 961px) {
    .mobile-nav {
      display: none !important;
    }
  }

  @media (max-width: 600px) {
    .brand-name {
      font-size: 0.85rem;
    }

    .brand-mark {
      width: 24px;
      height: 24px;
    }

    .system-status {
      display: none;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark,
    .nav-link,
    .menu-toggle span {
      transition: none;
    }
  }
</style>
