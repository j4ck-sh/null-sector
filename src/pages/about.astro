---
import BaseLayout from "../layouts/BaseLayout.astro";
const focusAreas = [
  {
    number: "01",
    title: "Digital Forensics",
    description:
      "Understanding how digital evidence is collected, preserved, analysed, and interpreted. Particular attention goes to provenance, reproducibility, and the limits of what an artifact can establish.",
    tags: ["Evidence handling", "Artifact analysis", "Methodology"],
  },
  {
    number: "02",
    title: "Security Analysis",
    description:
      "Developing a structured approach to investigating suspicious activity, interpreting technical signals, and separating plausible explanations from supported conclusions.",
    tags: ["Investigation", "Detection", "Threat analysis"],
  },
  {
    number: "03",
    title: "Malware & Low-Level Systems",
    description:
      "Studying malware-development concepts, operating-system internals, and the relationship between software behaviour and defensive analysis within appropriate learning environments.",
    tags: ["Windows internals", "Malware concepts", "Systems"],
  },
  {
    number: "04",
    title: "Space-System Cybersecurity",
    description:
      "Exploring how spacecraft architecture, ground infrastructure, communications, and orbital constraints shape cybersecurity questions and investigative methods.",
    tags: ["Satellite OSINT", "Space systems", "Communications"],
  },
];
const principles = [
  {
    number: "01",
    title: "Evidence before conclusions",
    description:
      "A technical claim should be supported by identifiable sources, documented observations, or reproducible work. Assumptions and uncertainty should remain visible.",
  },
  {
    number: "02",
    title: "Training is not independent research",
    description:
      "Completed courses, guided walkthroughs, controlled exercises, and original investigations are different kinds of experience. This site labels them accordingly.",
  },
  {
    number: "03",
    title: "Document the process",
    description:
      "Methods, tools, limitations, and unsuccessful attempts can be as useful to record as successful results.",
  },
  {
    number: "04",
    title: "Stay within authorised environments",
    description:
      "Practical security work belongs in controlled labs, intentionally provided exercises, or systems where appropriate permission has been granted.",
  },
];
const learningRecords = [
  {
    title: "TryHackMe — Security Analyst Level 1",
    type: "TRAINING PATH",
    status: "Training completed",
    detail:
      "Completed the SAL1 training material. Preparing for the certification examination; certification has not been earned.",
    href: "/learning/tryhackme-sal1/",
  },
  {
    title: "MalDev Academy",
    type: "COURSE COMPLETION",
    status: "Completed",
    detail:
      "Completed the main modules of the malware-development course and received its course completion certificate.",
    href: "/learning/maldev-academy/",
  },
  {
    title: "Satellite Cybersecurity Foundations",
    type: "COURSE COMPLETION",
    status: "Completed",
    detail:
      "Completed Angelina Tsuboi's Udemy course, including following the instructor-guided Hack the Orbit walkthrough.",
    href: "/learning/satellite-cybersecurity/",
  },
];
const siteSections = [
  {
    label: "01 / LEARNING",
    title: "Learning",
    description:
      "Training records, completed coursework, guided exercises, and reflections on technical concepts.",
    href: "/learning/",
    linkText: "Browse learning",
  },
  {
    label: "02 / RESEARCH",
    title: "Research",
    description:
      "Focused technical questions explored through attributed sources, documented methods, and explicit evidence boundaries.",
    href: "/research/",
    linkText: "Explore research",
  },
  {
    label: "03 / FIELD NOTES",
    title: "Field Notes",
    description:
      "Smaller technical references, observations, lab notes, and working explanations.",
    href: "/field-notes/",
    linkText: "Read field notes",
  },
];
const basePath = import.meta.env.BASE_URL;
function withBase(path: string): string {
  const base = basePath.endsWith("/") ? basePath : `${basePath}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
}
---
<BaseLayout
  title="About | NULL SECTOR"
  description="About NULL SECTOR: an independent cybersecurity and digital-forensics learning portfolio focused on technical research, evidence, and documented progress."
>
  <main id="main-content" class="about-page">
<!-- HERO -->
    <section class="about-hero" aria-labelledby="about-heading">
      <div class="page-container">
        <div class="hero-topline">
          <span class="eyebrow">
            <span class="signal" aria-hidden="true"></span>
            NULL SECTOR / ABOUT
          </span>
          <span class="hero-index">PROFILE_001</span>
        </div>
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="section-kicker">
              INDEPENDENT LEARNING & RESEARCH
            </p>
            <h1 id="about-heading">
              Curiosity.
              <br />
              Method.
              <br />
              <span>Evidence.</span>
            </h1>
            <p class="hero-lead">
              NULL SECTOR is my personal space for studying
              cybersecurity, digital forensics, and the
              systems that connect them.
            </p>
            <p class="hero-description">
              It is a record of what I am learning, what
              I have completed, what I am investigating,
              and what the available evidence actually
              supports.
            </p>
            <div class="hero-actions">
              <a class="primary-link" href={withBase("/research/")}>
                Explore research
                <span aria-hidden="true">↗</span>
              </a>
              <a class="secondary-link" href={withBase("/learning/")}>
                View learning archive
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <aside
            class="identity-panel"
            aria-label="Portfolio overview"
          >
            <div class="panel-heading">
              <span>IDENTITY / NULL SECTOR</span>
              <span
                class="panel-marker"
                aria-hidden="true"
              >
                +
              </span>
            </div>
            <div class="identity-mark" aria-hidden="true">
              <span>N</span>
              <span>S</span>
              <div class="mark-cross mark-cross-a"></div>
              <div class="mark-cross mark-cross-b"></div>
            </div>
            <div class="identity-details">
              <div>
                <span class="detail-label">DOMAIN</span>
                <strong>
                  Cybersecurity / Digital Forensics
                </strong>
              </div>
              <div>
                <span class="detail-label">MODE</span>
                <strong>
                  Learning / Documentation / Research
                </strong>
              </div>
              <div>
                <span class="detail-label">PRINCIPLE</span>
                <strong>
                  Claims should match evidence.
                </strong>
              </div>
            </div>
            <div class="panel-footer">
              <span>BUILDING IN PUBLIC</span>
              <span
                class="footer-symbol"
                aria-hidden="true"
              >
                [ + ]
              </span>
            </div>
          </aside>
        </div>
      </div>
    </section>
<!-- INTRODUCTION -->
    <section
      class="about-section intro-section"
      aria-labelledby="intro-heading"
    >
      <div class="page-container section-grid">
        <div class="section-rail" aria-hidden="true">
          <span class="rail-number">
            01 / INTRODUCTION
          </span>
          <span class="rail-line"></span>
        </div>
        <div class="section-body prose-block">
          <p class="section-kicker">
            THE PERSON BEHIND THE WORK
          </p>
          <h2 id="intro-heading">
            Why NULL SECTOR exists
          </h2>
          <p class="large-paragraph">
            I am building my knowledge of cybersecurity
            through structured training, technical
            reading, and carefully documented research.
          </p>
          <p>
            My interests span digital forensics,
            security analysis, malware-related concepts,
            operating-system internals, and satellite
            cybersecurity. What connects these areas is
            a desire to understand how systems behave—and
            how to investigate that behaviour without
            jumping beyond the evidence.
          </p>
          <p>
            NULL SECTOR gives that work a consistent
            home. Rather than presenting a collection
            of unsupported claims or polished outcomes
            without context, I want the site to show
            the progression from learning a concept
            to examining it critically and, where
            appropriate, testing it in a controlled
            environment.
          </p>
          <p>
            The portfolio is a work in progress. Some
            records document completed training; others
            are technical references or investigations
            still being developed. Their status and
            scope should be clear to the reader.
          </p>
        </div>
      </div>
    </section>
<!-- CURRENT FOCUS -->
    <section
      class="about-section focus-section"
      aria-labelledby="focus-heading"
    >
      <div class="page-container">
        <div class="section-header">
          <div>
            <p class="section-kicker">
              AREAS OF INTEREST
            </p>
            <h2 id="focus-heading">
              Current <span>focus.</span>
            </h2>
          </div>
          <p class="section-header-note">
            Areas I am studying and developing—not
            a claim of specialist expertise in
            each domain.
          </p>
        </div>
        <div class="focus-grid">
          {
            focusAreas.map((area) => (
              <article class="focus-card">
                <div class="card-top">
                  <span class="card-index">
                    {area.number} / FOCUS
                  </span>
                  <span
                    class="card-symbol"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </div>
                <div class="focus-card-content">
                  <h3>{area.title}</h3>
                  <p>{area.description}</p>
                </div>
                <div
                  class="tag-list"
                  aria-label={`${area.title} topics`}
                >
                  {area.tags.map((tag) => (
                    <span class="topic-tag">{tag}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
<!-- WORKING PRINCIPLES -->
    <section
      class="about-section principles-section"
      aria-labelledby="principles-heading"
    >
      <div class="page-container section-grid">
        <div class="section-rail" aria-hidden="true">
          <span class="rail-number">
            02 / APPROACH
          </span>
          <span class="rail-line"></span>
        </div>
        <div class="section-body">
          <p class="section-kicker">
            WORKING PRINCIPLES
          </p>
          <h2 id="principles-heading">
            How I approach the work
          </h2>
          <p class="section-introduction">
            Technical work is more useful when readers
            can distinguish observation, interpretation,
            and uncertainty.
          </p>
          <div class="principles-list">
            {
              principles.map((principle) => (
                <article class="principle-item">
                  <span
                    class="principle-number"
                    aria-hidden="true"
                  >
                    {principle.number}
                  </span>
                  <div>
                    <h3>{principle.title}</h3>
                    <p>{principle.description}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>
<!-- LEARNING MILESTONES -->
    <section
      class="about-section learning-section"
      aria-labelledby="learning-heading"
    >
      <div class="page-container">
        <div class="section-header">
          <div>
            <p class="section-kicker">
              DOCUMENTED PROGRESS
            </p>
            <h2 id="learning-heading">
              Learning <span>milestones.</span>
            </h2>
          </div>
          <a class="text-link" href={withBase("/learning/")}>
            Full learning archive
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="learning-introduction">
          These records describe completed training
          and coursework. Course completion and
          professional certification are identified
          separately.
        </p>
        <div class="learning-list">
          {
            learningRecords.map((record) => (
              <a
                class="learning-row"
                href={withBase(record.href)}
              >
                <span class="learning-row-type">
                  {record.type}
                </span>
                <div class="learning-row-main">
                  <h3>{record.title}</h3>
                  <p>{record.detail}</p>
                </div>
                <div class="learning-row-end">
                  <span class="learning-status">
                    {record.status}
                  </span>
                  <span
                    class="row-arrow"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </div>
              </a>
            ))
          }
        </div>
        <p class="learning-disclaimer">
          <span aria-hidden="true">*</span>
          TryHackMe SAL1 training is complete, but the
          certification examination has not been passed.
          MalDev Academy completion refers to its course
          modules and completion certificate. Satellite
          Cybersecurity Foundations is a completed Udemy
          course, not a professional certification.
        </p>
      </div>
    </section>
<!-- SITE DIRECTORY -->
    <section
      class="about-section archive-section"
      aria-labelledby="archive-heading"
    >
      <div class="page-container">
        <div class="section-header">
          <div>
            <p class="section-kicker">
              SITE DIRECTORY
            </p>
            <h2 id="archive-heading">
              Explore the <span>archive.</span>
            </h2>
          </div>
          <p class="section-header-note">
            Three ways of documenting progress,
            each with a different purpose.
          </p>
        </div>
        <div class="archive-grid">
          {
            siteSections.map((section) => (
              <a
                class="archive-card"
                href={withBase(section.href)}
              >
                <span class="archive-label">
                  {section.label}
                </span>
                <div class="archive-card-content">
                  <h3>{section.title}</h3>
                  <p>{section.description}</p>
                </div>
                <span class="archive-link">
                  {section.linkText}
                  <span aria-hidden="true">↗</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
<!-- CLOSING -->
    <section
      class="closing-section"
      aria-labelledby="closing-heading"
    >
      <div class="page-container closing-inner">
        <div>
          <p class="section-kicker">
            END OF PROFILE / CONTINUE EXPLORING
          </p>
          <h2 id="closing-heading">
            The work is
            <br />
            <span>ongoing.</span>
          </h2>
          <p>
            NULL SECTOR will continue to grow through
            learning, documented experiments, and
            research grounded in identifiable evidence.
          </p>
        </div>
        <a
          class="closing-link"
          href={withBase("/research/")}
        >
          <span>OPEN RESEARCH ARCHIVE</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .about-page {
    --about-bg: var(--bg);
    --about-panel: var(--bg-panel);
    --about-panel-raised: var(--bg-raised);
    --about-line: var(--border);
    --about-text: var(--text);
    --about-muted: var(--text-muted);
    --about-green: var(--green);
    --about-blue: var(--blue);
    background: var(--about-bg);
    color: var(--about-text);
    overflow: clip;
  }
  .page-container {
    width: min(
      calc(100% - 2 * var(--page-gutter, 1.25rem)),
      var(--container-width, 1280px)
    );
    margin-inline: auto;
  }
  .about-page a {
    color: inherit;
    text-decoration: none;
  }
  .about-page a:focus-visible {
    outline: 2px solid var(--blue-bright);
    outline-offset: 4px;
  }
  .about-page h1,
  .about-page h2,
  .about-page h3,
  .about-page p {
    overflow-wrap: break-word;
  }
  .section-kicker,
  .eyebrow,
  .hero-index,
  .rail-number,
  .card-index,
  .detail-label,
  .panel-heading,
  .panel-footer,
  .topic-tag,
  .principle-number,
  .learning-row-type,
  .learning-status,
  .archive-label,
  .archive-link,
  .closing-link,
  .learning-disclaimer {
    font-family: var(--font-mono);
    letter-spacing: 0.06em;
  }
  .section-kicker {
    margin: 0 0 1.15rem;
    color: var(--about-green);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.6;
    text-transform: uppercase;
  }
/* Hero */
  .about-hero {
    position: relative;
    border-bottom: 1px solid var(--about-line);
    background:
      linear-gradient(
        rgba(166, 227, 173, 0.025) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(166, 227, 173, 0.025) 1px,
        transparent 1px
      ),
      var(--about-bg);
    background-size: 42px 42px;
  }
  .about-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(12, 16, 16, 0.18) 55%,
      rgba(12, 16, 16, 0.52) 100%
    );
  }
  .about-hero > .page-container {
    position: relative;
    z-index: 1;
  }
  .hero-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1.65rem;
    border-bottom: 1px solid var(--about-line);
  }
  .eyebrow,
  .hero-index {
    color: var(--about-muted);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .signal {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    background: var(--about-green);
    box-shadow: 0 0 12px rgba(166, 227, 173, 0.3);
  }
  .hero-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.15fr)
      minmax(290px, 0.85fr);
    align-items: center;
    gap: clamp(2.5rem, 6vw, 7rem);
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .hero-copy,
  .identity-panel {
    min-width: 0;
  }
  .hero-copy h1 {
    margin: 0 0 2.25rem;
    font-size: clamp(3.6rem, 7.4vw, 8rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.075em;
  }
  .hero-copy h1 span {
    color: var(--about-green);
  }
  .hero-lead {
    max-width: 650px;
    margin: 0 0 1.25rem;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    font-weight: 500;
    line-height: 1.55;
  }
  .hero-description {
    max-width: 600px;
    margin: 0;
    color: var(--about-muted);
    font-size: 0.95rem;
    line-height: 1.85;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.5rem;
  }
  .primary-link,
  .secondary-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    min-height: 48px;
    padding: 0.85rem 1.15rem;
    border: 1px solid var(--about-line);
    border-radius: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }
  .primary-link {
    background: var(--about-green);
    border-color: var(--about-green);
    color: var(--about-bg) !important;
  }
  .primary-link:hover {
    background: var(--green-bright);
    border-color: var(--green-bright);
  }
  .secondary-link:hover {
    background: var(--about-panel-raised);
    border-color: var(--about-green);
  }
/* Identity panel */
  .identity-panel {
    border: 1px solid var(--border-strong);
    background: var(--about-panel);
    box-shadow: 12px 12px 0 rgba(166, 227, 173, 0.035);
  }
  .panel-heading,
  .panel-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.2rem;
    color: var(--about-muted);
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .panel-heading {
    border-bottom: 1px solid var(--about-line);
  }
  .panel-marker,
  .footer-symbol {
    color: var(--about-green);
  }
  .identity-mark {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.2em;
    min-height: 290px;
    border-bottom: 1px solid var(--about-line);
    color: var(--about-green);
    font-family: var(--font-mono);
    font-size: clamp(5.5rem, 10vw, 10rem);
    font-weight: 800;
    letter-spacing: -0.14em;
    line-height: 1;
    text-shadow: 0 0 45px rgba(166, 227, 173, 0.12);
    overflow: hidden;
  }
  .identity-mark::before,
  .identity-mark::after {
    content: "";
    position: absolute;
    pointer-events: none;
  }
  .identity-mark::before {
    inset: 20px;
    border: 1px solid rgba(166, 227, 173, 0.08);
  }
  .identity-mark::after {
    width: 110%;
    height: 1px;
    background: rgba(166, 227, 173, 0.2);
    transform: rotate(-28deg);
  }
  .mark-cross {
    position: absolute;
    width: 13px;
    height: 13px;
    border: 1px solid var(--about-green);
    opacity: 0.55;
  }
  .mark-cross-a {
    top: 18px;
    left: 18px;
  }
  .mark-cross-b {
    right: 18px;
    bottom: 18px;
  }
  .identity-details {
    display: grid;
    gap: 1.35rem;
    padding: 1.5rem 1.2rem;
  }
  .identity-details > div {
    display: grid;
    gap: 0.4rem;
  }
  .detail-label {
    color: var(--about-muted);
    font-size: 0.62rem;
  }
  .identity-details strong {
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.6;
  }
  .panel-footer {
    border-top: 1px solid var(--about-line);
  }
/* Shared section layout */
  .about-section {
    padding-block: clamp(4.5rem, 8vw, 8rem);
    border-bottom: 1px solid var(--about-line);
  }
  .section-grid {
    display: grid;
    grid-template-columns:
      minmax(145px, 0.27fr)
      minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 7rem);
  }
  .section-rail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    padding-top: 0.4rem;
  }
  .rail-number {
    color: var(--about-muted);
    font-size: 0.68rem;
    white-space: nowrap;
  }
  .rail-line {
    width: 1px;
    min-height: 90px;
    flex: 1;
    background: linear-gradient(
      var(--about-green),
      transparent
    );
    opacity: 0.45;
  }
  .section-body {
    min-width: 0;
    max-width: 920px;
  }
  .about-section h2 {
    margin: 0;
    font-size: clamp(2.1rem, 4.5vw, 4.5rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.06em;
  }
  .section-header h2 span {
    color: var(--about-blue);
  }
/* Introduction */
  .prose-block p:not(.section-kicker) {
    max-width: 770px;
    color: var(--about-muted);
    font-size: 0.98rem;
    line-height: 1.95;
  }
  .prose-block .large-paragraph {
    margin-top: 2rem;
    color: var(--about-text) !important;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem) !important;
    line-height: 1.7 !important;
  }
/* Section headers */
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }
