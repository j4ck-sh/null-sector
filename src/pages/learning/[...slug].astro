---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

interface Props {
  entry: CollectionEntry<"learning">;
}

export async function getStaticPaths() {
  const entries = await getCollection(
    "learning",
    ({ data }) => !data.draft
  );

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const {
  title,
  description,
  provider,
  category,
  status,
  certificationStatus,
  publishedAt,
  completedAt,
  updatedAt,
  topics,
  skills,
  references,
  credentialUrl,
  certificate,
} = entry.data;

const categoryLabels: Record<string, string> = {
  "certification-training": "CERTIFICATION TRAINING",
  "learning-path": "LEARNING PATH",
  course: "COURSE",
  lab: "PRACTICAL LAB",
};

const statusLabels: Record<string, string> = {
  planned: "PLANNED",
  "in-progress": "IN PROGRESS",
  completed: "COMPLETED",
};

const certificationLabels: Record<string, string> = {
  "not-applicable": "NOT APPLICABLE",
  "not-attempted": "NOT ATTEMPTED",
  preparing: "PREPARING",
  earned: "EARNED",
};

const certificateTypeLabels: Record<string, string> = {
  "professional-certification": "PROFESSIONAL CERTIFICATION",
  "course-completion": "COURSE COMPLETION",
  "training-award": "TRAINING AWARD",
};

const categoryLabel = categoryLabels[category] ?? category;
const statusLabel = statusLabels[status] ?? status;
const certificationLabel =
  certificationLabels[certificationStatus] ?? certificationStatus;

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const formatDate = (date: Date) => dateFormatter.format(date);

const chapters = headings.filter(
  (heading) => heading.depth === 2
);

const hasTechnicalIndex =
  topics.length > 0 || skills.length > 0;

const certificateTypeLabel = certificate
  ? certificateTypeLabels[certificate.type] ?? certificate.type
  : "";

const basePath = import.meta.env.BASE_URL;

function withBase(path: string): string {
  if (!path.startsWith("/") || path.startsWith("//")) return path;
  const base = basePath.endsWith("/") ? basePath : `${basePath}/`;
  return `${base}${path.replace(/^\/+/, "")}`;
}

function assetUrl(path: string): string {
  return withBase(path);
}

const hasCredentialSection = Boolean(
  certificate || credentialUrl
);
---

<BaseLayout
  title={`${title} | Learning | NULL SECTOR`}
  description={description}
  contentType="article"
  publishedTime={publishedAt.toISOString()}
  modifiedTime={updatedAt?.toISOString()}
>
  <main class="article-shell" id="main-content">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={withBase("/")}>HOME</a>
        <span aria-hidden="true">/</span>
        <a href={withBase("/learning/")}>LEARNING</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">ARTICLE</span>
      </nav>
    </div>

    <header class="article-header">
      <div class="container">
        <div class="header-meta">
          <span class="eyebrow">[ NS / LEARNING RECORD ]</span>
          <span class="record-id">
            FILE: {entry.id.toUpperCase()}
          </span>
        </div>

        <div class="header-main">
          <div class="header-copy">
            <span class="article-category">{categoryLabel}</span>

            <h1>
              {title}<span class="title-cursor">_</span>
            </h1>

            <p class="article-description">{description}</p>
          </div>

          <div class="header-symbol" aria-hidden="true">
            <span>N</span>
            <span>S</span>
          </div>
        </div>

        <div class="article-metadata">
          <div class="metadata-item">
            <span class="metadata-label">PROVIDER</span>
            <span class="metadata-value">{provider}</span>
          </div>

          <div class="metadata-item">
            <span class="metadata-label">LEARNING STATUS</span>
            <span
              class:list={[
                "metadata-value",
                "status-value",
                `status-${status}`,
              ]}
            >
              <span class="status-square" aria-hidden="true"></span>
              {statusLabel}
            </span>
          </div>

          <div class="metadata-item">
            <span class="metadata-label">CERTIFICATION</span>
            <span
              class:list={[
                "metadata-value",
                {
                  "credential-earned":
                    certificationStatus === "earned",
                },
              ]}
            >
              {certificationLabel}
            </span>
          </div>

          <div class="metadata-item">
            <span class="metadata-label">PUBLISHED</span>
            <time datetime={publishedAt.toISOString()}>
              {formatDate(publishedAt)}
            </time>
          </div>
        </div>
      </div>
    </header>

    <div class="container article-container">
      <div
        class:list={[
          "reading-layout",
          { "without-sidebar": chapters.length === 0 },
        ]}
      >
        {
          chapters.length > 0 && (
            <aside
              class="reading-sidebar"
              aria-labelledby="chapter-nav-title"
            >
              <div class="sidebar-sticky">
                <div class="sidebar-panel">
                  <div class="sidebar-header">
                    <span class="sidebar-eyebrow">
                      [ CONTENTS ]
                    </span>

                    <h2 id="chapter-nav-title">
                      Explore the article
                      <span class="sidebar-cursor">_</span>
                    </h2>

                    <p class="sidebar-description">
                      Navigate the technical record.
                    </p>
                  </div>

                  <nav
                    class="chapter-nav"
                    aria-label="Article chapters"
                  >
                    <ol class="chapter-list">
                      {chapters.map((heading, index) => (
                        <li>
                          <a
                            class="chapter-link"
                            href={`#${heading.slug}`}
                            data-chapter-link={heading.slug}
                          >
                            <span class="chapter-number">
                              {String(index + 1).padStart(2, "0")}
                            </span>

                            <span class="chapter-title">
                              {heading.text}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>

                  <div class="reading-progress">
                    <div class="progress-heading">
                      <span>READING PROGRESS</span>
                      <output
                        id="reading-percentage"
                        aria-label="Reading progress"
                      >
                        0%
                      </output>
                    </div>

                    <div
                      class="progress-track"
                      role="progressbar"
                      aria-label="Article reading progress"
                      aria-valuemin="0"
                      aria-valuemax="100"
                      aria-valuenow="0"
                      id="reading-progress-bar"
                    >
                      <div
                        class="progress-fill"
                        id="reading-progress-fill"
                      ></div>
                    </div>

                    <div class="progress-footer">
                      <span id="current-chapter">
                        CHAPTER 01
                      </span>
                      <span>
                        {String(chapters.length).padStart(2, "0")}
                        {" "}TOTAL
                      </span>
                    </div>
                  </div>
                </div>

                <a class="sidebar-back" href={withBase("/learning/")}>
                  <span aria-hidden="true">←</span>
                  BACK TO LEARNING
                </a>
              </div>
            </aside>
          )
        }

        <article class="article-main" id="article-content">
          <div class="article-topbar">
            <span>
              DOCUMENT / {entry.id.toUpperCase()}
            </span>
            <span>MARKDOWN RECORD</span>
          </div>

          {
            chapters.length > 0 && (
              <div class="mobile-chapter-nav">
                <label for="mobile-chapter-select">
                  [ EXPLORE THE ARTICLE ]
                </label>

                <select
                  id="mobile-chapter-select"
                  aria-label="Jump to article chapter"
                >
                  {chapters.map((heading, index) => (
                    <option value={heading.slug}>
                      {String(index + 1).padStart(2, "0")}
                      {" — "}
                      {heading.text}
                    </option>
                  ))}
                </select>

                <div class="mobile-progress">
                  <span>READING PROGRESS</span>
                  <span id="mobile-reading-percentage">
                    0%
                  </span>
                </div>

                <div class="mobile-progress-track">
                  <div
                    class="mobile-progress-fill"
                    id="mobile-progress-fill"
                  ></div>
                </div>
              </div>
            )
          }

          <div class="article-body">
            <Content />
          </div>

          {
            hasCredentialSection && (
              <section
                class="certificate-section"
                id="credential"
                aria-labelledby="certificate-section-title"
              >
                <div class="certificate-heading">
                  <div>
                    <span class="eyebrow">
                      [ CREDENTIAL RECORD ]
                    </span>
                    <h2 id="certificate-section-title">
                      Certificate & Credential
                      <span class="certificate-cursor">_</span>
                    </h2>
                  </div>

                  <span class="certificate-record-label">
                    VERIFIED INFORMATION / AS PROVIDED
                  </span>
                </div>

                {certificate ? (
                  <>
                    <div class="certificate-preview">
                      <a
                        href={assetUrl(certificate.image)}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`View full-size certificate: ${certificate.title}`}
                      >
                        <img
                          src={assetUrl(certificate.image)}
                          alt={certificate.alt}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    </div>

                    <div class="certificate-details">
                      <div class="certificate-detail">
                        <span class="certificate-detail-label">
                          CERTIFICATE
                        </span>
                        <strong>{certificate.title}</strong>
                      </div>

                      <div class="certificate-detail">
                        <span class="certificate-detail-label">
                          CREDENTIAL TYPE
                        </span>
                        <span>{certificateTypeLabel}</span>
                      </div>

                      <div class="certificate-detail">
                        <span class="certificate-detail-label">
                          ISSUED BY
                        </span>
                        <span>{certificate.issuer}</span>
                      </div>

                      {certificate.issuedAt && (
                        <div class="certificate-detail">
                          <span class="certificate-detail-label">
                            DATE ISSUED
                          </span>
                          <time
                            datetime={certificate.issuedAt.toISOString()}
                          >
                            {formatDate(certificate.issuedAt)}
                          </time>
                        </div>
                      )}

                      {certificate.credentialId && (
                        <div class="certificate-detail">
                          <span class="certificate-detail-label">
                            CREDENTIAL ID
                          </span>
                          <span class="certificate-id">
                            {certificate.credentialId}
                          </span>
                        </div>
                      )}
                    </div>

                    <div class="certificate-actions">
                      <a
                        class="certificate-action"
                        href={assetUrl(certificate.image)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        VIEW FULL CERTIFICATE
                        <span aria-hidden="true">↗</span>
                      </a>

                      {credentialUrl && (
                        <a
                          class="certificate-action certificate-action-primary"
                          href={credentialUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          VIEW CREDENTIAL RECORD
                          <span aria-hidden="true">↗</span>
                        </a>
                      )}
                    </div>
                  </>
                ) : (
                  <div class="credential-link-only">
                    <p>
                      A credential record is available for this
                      learning entry.
                    </p>

                    {credentialUrl && (
                      <a
                        class="certificate-action certificate-action-primary"
                        href={credentialUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        VIEW CREDENTIAL RECORD
                        <span aria-hidden="true">↗</span>
                      </a>
                    )}
                  </div>
                )}

                {certificate?.type === "course-completion" && (
                  <p class="certificate-disclaimer">
                    This document records course completion. It
                    does not represent a professional certification.
                  </p>
                )}

                {certificate?.type === "training-award" && (
                  <p class="certificate-disclaimer">
                    This document records a training award.
                    It does not establish professional
                    certification status.
                  </p>
                )}
              </section>
            )
          }

          {
            (completedAt || updatedAt) && (
              <div class="article-dates">
                {completedAt && (
                  <p>
                    <span>TRAINING COMPLETED:</span>
                    <time datetime={completedAt.toISOString()}>
                      {formatDate(completedAt)}
                    </time>
                  </p>
                )}

                {updatedAt && (
                  <p>
                    <span>LAST UPDATED:</span>
                    <time datetime={updatedAt.toISOString()}>
                      {formatDate(updatedAt)}
                    </time>
                  </p>
                )}
              </div>
            )
          }

          {
            references.length > 0 && (
              <section
                class="references-panel"
                aria-labelledby="references-title"
              >
                <span class="eyebrow">
                  [ EXTERNAL RESOURCES ]
                </span>

                <h2 id="references-title">
                  References
                </h2>

                <ul>
                  {references.map((reference) => (
                    <li>
                      <a
                        href={reference.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {reference.label}
                        <span aria-hidden="true">↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            hasTechnicalIndex && (
              <section
                class="technical-index"
                aria-labelledby="technical-index-title"
              >
                <div class="technical-index-header">
                  <span class="eyebrow">
                    [ TECHNICAL INDEX ]
                  </span>

                  <h2 id="technical-index-title">
                    Knowledge areas
                    <span class="index-cursor">_</span>
                  </h2>
                </div>

                {topics.length > 0 && (
                  <div class="index-group">
                    <span class="index-group-label">
                      TOPICS
                    </span>

                    <div class="index-tags">
                      {topics.map((topic) => (
                        <span class="index-tag">
                          {topic}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                {skills.length > 0 && (
                  <div class="index-group">
                    <span class="index-group-label">
                      SKILLS
                    </span>

                    <div class="index-tags">
                      {skills.map((skill) => (
                        <span class="index-tag">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                )}
              </section>
            )
          }

          <div class="article-end">
            <span>END OF DOCUMENT</span>
            <span>[ EOF ]</span>
          </div>

          <nav
            class="article-navigation"
            aria-label="Article navigation"
          >
            <a href={withBase("/learning/")}>
              <span aria-hidden="true">←</span>
              RETURN TO LEARNING ARCHIVE
            </a>

            <a href={withBase("/research/")}>
              EXPLORE RESEARCH
              <span aria-hidden="true">↗</span>
            </a>
          </nav>
        </article>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  function initReadingNavigator() {
    const articleElement =
      document.querySelector<HTMLElement>(
        "#article-content"
      );

    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        "[data-chapter-link]"
      )
    );

    if (!articleElement || links.length === 0) {
      return;
    }

    const article: HTMLElement = articleElement;

    const headings = links
      .map((link) => {
        const id = link.dataset.chapterLink;
        return id ? document.getElementById(id) : null;
      })
      .filter(
        (heading): heading is HTMLElement =>
          heading !== null
      );

    if (headings.length === 0) {
      return;
    }

    const chapterNav =
      document.querySelector<HTMLElement>(
        ".chapter-nav"
      );

    const percentage =
      document.querySelector<HTMLOutputElement>(
        "#reading-percentage"
      );

    const progressBar =
      document.querySelector<HTMLElement>(
        "#reading-progress-bar"
      );

    const progressFill =
      document.querySelector<HTMLElement>(
        "#reading-progress-fill"
      );

    const currentChapter =
      document.querySelector<HTMLElement>(
        "#current-chapter"
      );

    const mobileSelect =
      document.querySelector<HTMLSelectElement>(
        "#mobile-chapter-select"
      );

    const mobilePercentage =
      document.querySelector<HTMLElement>(
        "#mobile-reading-percentage"
      );

    const mobileFill =
      document.querySelector<HTMLElement>(
        "#mobile-progress-fill"
      );

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    let activeIndex = -1;
    let ticking = false;

    function setActiveChapter(index: number) {
      if (index === activeIndex) {
        return;
      }

      activeIndex = index;

      links.forEach((link, linkIndex) => {
        const isActive = linkIndex === index;

        link.classList.toggle("is-active", isActive);

        if (isActive) {
          link.setAttribute(
            "aria-current",
            "location"
          );
        } else {
          link.removeAttribute("aria-current");
        }
      });

      if (currentChapter) {
        currentChapter.textContent =
          `CHAPTER ${String(index + 1).padStart(2, "0")}`;
      }

      if (mobileSelect) {
        const id = headings[index]?.id;

        if (id) {
          mobileSelect.value = id;
        }
      }

      const activeLink = links[index];

      if (activeLink && chapterNav) {
        const navBounds =
          chapterNav.getBoundingClientRect();

        const linkBounds =
          activeLink.getBoundingClientRect();

        const above =
          linkBounds.top < navBounds.top;

        const below =
          linkBounds.bottom > navBounds.bottom;

        if (above || below) {
          chapterNav.scrollTo({
            top:
              chapterNav.scrollTop +
              linkBounds.top -
              navBounds.top -
              navBounds.height / 2 +
              linkBounds.height / 2,
            behavior: reducedMotion.matches
              ? "auto"
              : "smooth",
          });
        }
      }
    }

    function updateReadingPosition() {
      const readingLine = 140;
      let index = 0;

      for (let i = 0; i < headings.length; i++) {
        const heading = headings[i];

        if (
          heading.getBoundingClientRect().top <=
          readingLine
        ) {
          index = i;
        } else {
          break;
        }
      }

      setActiveChapter(index);

      const articleBounds =
        article.getBoundingClientRect();

      const articleTop =
        articleBounds.top + window.scrollY;

      const articleBottom =
        articleBounds.bottom + window.scrollY;

      const start = articleTop;
      const end =
        articleBottom - window.innerHeight;

      const progress =
        end <= start
          ? window.scrollY >= start
            ? 100
            : 0
          : Math.min(
              100,
              Math.max(
                0,
                ((window.scrollY - start) /
                  (end - start)) *
                  100
              )
            );

      const rounded = Math.round(progress);

      if (percentage) {
        percentage.textContent = `${rounded}%`;
      }

      if (mobilePercentage) {
        mobilePercentage.textContent =
          `${rounded}%`;
      }

      if (progressFill) {
        progressFill.style.width =
          `${progress}%`;
      }

      if (mobileFill) {
        mobileFill.style.width =
          `${progress}%`;
      }

      if (progressBar) {
        progressBar.setAttribute(
          "aria-valuenow",
          String(rounded)
        );
      }
    }

    function requestUpdate() {
      if (ticking) {
        return;
      }

      ticking = true;

      window.requestAnimationFrame(() => {
        updateReadingPosition();
        ticking = false;
      });
    }

    mobileSelect?.addEventListener(
      "change",
      () => {
        const target = document.getElementById(
          mobileSelect.value
        );

        if (!target) {
          return;
        }

        target.scrollIntoView({
          behavior: reducedMotion.matches
            ? "auto"
            : "smooth",
          block: "start",
        });

        const index = headings.indexOf(target);

        if (index >= 0) {
          setActiveChapter(index);
        }
      }
    );

    window.addEventListener(
      "scroll",
      requestUpdate,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      requestUpdate,
      { passive: true }
    );

    window.addEventListener(
      "load",
      requestUpdate,
      { once: true }
    );

    requestUpdate();
  }

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initReadingNavigator,
      { once: true }
    );
  } else {
    initReadingNavigator();
  }
</script>

<style>
*/* Article shell */*

  .article-shell {
    padding-top: 2rem;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--green);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--green);
  }

*/* Header */*

  .article-header {
    padding: 2rem 0 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .header-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .record-id {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    overflow-wrap: anywhere;
  }

  .header-main {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  .header-copy {
    min-width: 0;
  }

  .article-category {
    display: block;
    margin-bottom: 1.25rem;
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .article-header h1 {
    max-width: 850px;
    margin-bottom: 1.5rem;
    font-size: clamp(2.5rem, 5vw, 5rem);
    letter-spacing: -0.065em;
    line-height: 1.08;
    overflow-wrap: break-word;
  }

  .title-cursor {
    color: var(--green);
  }

  .article-description {
    max-width: 700px;
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .header-symbol {
    display: flex;
    width: 110px;
    height: 110px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    border: 1px solid var(--border-strong);
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.15em;
  }

  .header-symbol span:last-child {
    color: var(--blue);
  }

  .article-metadata {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .metadata-item {
    display: flex;
    min-height: 100px;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem;
    border-right: 1px solid var(--border);
  }

  .metadata-item:first-child {
    padding-left: 0;
  }

  .metadata-item:last-child {
    border-right: 0;
  }

  .metadata-label {
    color: var(--text-dim);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }

