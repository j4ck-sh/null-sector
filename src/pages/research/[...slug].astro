
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

type ResearchEntry = CollectionEntry<"research">;

export async function getStaticPaths() {
  const entries = await getCollection(
    "research",
    ({ data }) => !data.draft
  );

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: ResearchEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const data = entry.data;

const statusLabels = {
  planned: "PLANNED",
  "in-progress": "IN PROGRESS",
  completed: "COMPLETED",
} as const;

const evidenceLabels = {
  "public-source": "PUBLIC SOURCE",
  modelled: "MODELLED",
  simulated: "SIMULATED",
  "controlled-lab": "CONTROLLED LAB",
  "evidence-backed": "EVIDENCE BACKED",
  theoretical: "THEORETICAL",
  mixed: "MIXED",
} as const;

const categoryLabels = {
  "satellite-security": "Satellite Security",
  "drone-security": "Drone Forensics",
  "mobile-forensics": "Mobile Forensics",
  "iot-security": "IoT Forensics",
  "vehicle-security": "Vehicle Security",
  "malware-analysis": "Malware Analysis",
  "network-forensics": "Incident Response",
  "ethical-hacking": "Ethical Hacking",
  other: "Other Research",
} as const;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    timeZone: "UTC",
  }).format(date);

/*
 * Markdown headings already contain their chapter numbers.
 *
 * Example:
 *   ## 01 — Abstract
 *
 * We therefore preserve their original text rather than
 * generating a second number in the navigation.
 */
const chapters = headings
  .filter((heading) => heading.depth === 2)
  .map((heading) => ({
    id: heading.slug,
    title: heading.text,
  }));

const navigation = [
  {
    id: "methodology",
    title: "Methodology",
    type: "structured",
  },
  ...chapters.map((chapter) => ({
    ...chapter,
    type: "chapter",
  })),
  {
    id: "evidence-register",
    title: "Evidence Register",
    type: "structured",
  },
  {
    id: "findings",
    title: "Findings",
    type: "structured",
  },
  {
    id: "limitations",
    title: "Limitations",
    type: "structured",
  },
  {
    id: "references",
    title: "References",
    type: "structured",
  },
];

const evidenceIds = new Set(
  data.evidence.map((item) => item.id)
);

const [
  publishedResearch,
  publishedLearning,
  publishedNotes,
] = await Promise.all([
  getCollection("research", ({ data }) => !data.draft),
  getCollection("learning", ({ data }) => !data.draft),
  getCollection("fieldNotes", ({ data }) => !data.draft),
]);

const relatedResearch = publishedResearch.filter(
  (item) =>
    item.id !== entry.id &&
    data.relatedResearch.includes(item.id)
);

const relatedLearning = publishedLearning.filter(
  (item) => data.relatedLearning.includes(item.id)
);

const relatedNotes = publishedNotes.filter(
  (item) => data.relatedNotes.includes(item.id)
);

const relatedRecords = [
  ...relatedResearch.map((item) => ({
    id: item.id,
    type: "RESEARCH",
    title: item.data.title,
    status: statusLabels[item.data.status],
    href: `/research/${item.id}/`,
  })),
  ...relatedLearning.map((item) => ({
    id: item.id,
    type: "LEARNING",
    title: item.data.title,
    status: statusLabels[item.data.status],
    href: `/learning/${item.id}/`,
  })),
  ...relatedNotes.map((item) => ({
    id: item.id,
    type: "FIELD NOTE",
    title: item.data.title,
    status: statusLabels[item.data.status],
    href: `/field-notes/${item.id}/`,
  })),
];

const hasBody = headings.length > 0;
const hasEvidence = data.evidence.length > 0;
const hasStructuredFindings = data.findings.length > 0;
const hasRelated = relatedRecords.length > 0;
---

<BaseLayout
  title={`${data.title} | Research | NULL SECTOR`}
  description={data.description}
  contentType="article"
  publishedTime={data.publishedAt.toISOString()}
  modifiedTime={data.updatedAt?.toISOString()}
>
  <main id="main-content" class="research-article">
    <header class="article-hero">
      <div class="container">
        <div class="hero-topline">
          <a href="/research/" class="back-link">
            <span aria-hidden="true">←</span>
            RESEARCH ARCHIVE
          </a>

          <span class="system-label">
            NULL SECTOR / RESEARCH.RECORD
          </span>
        </div>

        <div class="hero-grid">
          <div class="hero-main">
            <div class="record-label">
              <span
                class="record-square"
                aria-hidden="true"
              ></span>

              TECHNICAL RESEARCH RECORD

              <span class="record-separator">/</span>

              {categoryLabels[data.category]}
            </div>

            <h1>{data.title}</h1>

            <p class="hero-description">
              {data.description}
            </p>

            {data.topics.length > 0 && (
              <div class="hero-tags">
                {data.topics.map((topic) => (
                  <span class="topic-tag">
                    {topic}
                  </span>
                ))}
              </div>
            )}
          </div>

          <aside
            class="record-panel"
            aria-label="Research record details"
          >
            <div class="panel-header">
              <span>RECORD.METADATA</span>
              <span aria-hidden="true">[+]</span>
            </div>

            <dl class="metadata-list">
              <div>
                <dt>STATUS</dt>
                <dd class={`status-${data.status}`}>
                  {statusLabels[data.status]}
                </dd>
              </div>

              <div>
                <dt>EVIDENCE BASIS</dt>
                <dd>
                  {evidenceLabels[data.evidenceType]}
                </dd>
              </div>

              <div>
                <dt>PUBLISHED</dt>
                <dd>{formatDate(data.publishedAt)}</dd>
              </div>

              {data.updatedAt && (
                <div>
                  <dt>UPDATED</dt>
                  <dd>{formatDate(data.updatedAt)}</dd>
                </div>
              )}

              {data.completedAt && (
                <div>
                  <dt>COMPLETED</dt>
                  <dd>{formatDate(data.completedAt)}</dd>
                </div>
              )}

              <div>
                <dt>EVIDENCE ITEMS</dt>
                <dd>
                  {String(data.evidence.length).padStart(2, "0")}
                </dd>
              </div>

              <div>
                <dt>STRUCTURED FINDINGS</dt>
                <dd>
                  {String(data.findings.length).padStart(2, "0")}
                </dd>
              </div>
            </dl>

            <div class="panel-footer">
              <span>METHOD / EVIDENCE / LIMITATIONS</span>
              <span
                class="panel-light"
                aria-hidden="true"
              ></span>
            </div>
          </aside>
        </div>
      </div>
    </header>

    <div class="container article-layout">
      <aside
        class="chapter-sidebar"
        aria-label="Article navigation"
      >
        <div class="sidebar-inner">
          <div class="sidebar-heading">
            <span
              class="sidebar-square"
              aria-hidden="true"
            ></span>
            <span>RECORD INDEX</span>
          </div>

          <nav aria-label="Research article sections">
            {navigation.map((section) => (
              <a
                href={`#${section.id}`}
                data-chapter-link
                class:list={[
                  "chapter-link",
                  {
                    "chapter-link-structured":
                      section.type === "structured",
                  },
                ]}
              >
                {section.type === "structured" && (
                  <span
                    class="chapter-marker"
                    aria-hidden="true"
                  >
                    ◆
                  </span>
                )}

                <span class="chapter-title">
                  {section.title}
                </span>
              </a>
            ))}
          </nav>

          <div class="sidebar-footer">
            RESEARCH / {entry.id.toUpperCase()}
          </div>
        </div>
      </aside>

      <article class="article-main">
        <div class="mobile-index">
          <label for="mobile-chapter-select">
            [ EXPLORE THE ARTICLE ]
          </label>

          <select
            id="mobile-chapter-select"
            aria-label="Jump to research article section"
          >
            {navigation.map((section) => (
              <option value={section.id}>
                {section.type === "structured"
                  ? `[ ${section.title.toUpperCase()} ]`
                  : section.title}
              </option>
            ))}
          </select>
        </div>

        <section
          id="methodology"
          class="record-section"
          aria-labelledby="methodology-heading"
        >
          <div class="section-topline">
            <span class="eyebrow">
              [ RESEARCH PROTOCOL ]
            </span>
            <span class="section-code">
              METHOD.01
            </span>
          </div>

          <h2 id="methodology-heading">
            Methodology<span class="accent-green">.</span>
          </h2>

          <p class="section-intro">
            This record separates its research objective,
            boundaries, environment, analytical approach,
            and assumptions.
          </p>

          <dl class="methodology-grid">
            <div>
              <dt>OBJECTIVE</dt>
              <dd>{data.methodology.objective}</dd>
            </div>

            <div>
              <dt>SCOPE</dt>
              <dd>{data.methodology.scope}</dd>
            </div>

            <div>
              <dt>ENVIRONMENT</dt>
              <dd>{data.methodology.environment}</dd>
            </div>

            <div>
              <dt>APPROACH</dt>
              <dd>{data.methodology.approach}</dd>
            </div>
          </dl>

          {data.methodology.assumptions.length > 0 && (
            <div class="methodology-assumptions">
              <h3>ASSUMPTIONS</h3>

              <ul>
                {data.methodology.assumptions.map(
                  (assumption) => (
                    <li>{assumption}</li>
                  )
                )}
              </ul>
            </div>
          )}
        </section>

        {hasBody && (
          <section
            class="record-section article-content"
            aria-label="Technical research narrative"
          >
            <div class="section-topline">
              <span class="eyebrow">
                [ TECHNICAL NARRATIVE ]
              </span>
              <span class="section-code">
                RESEARCH.NOTES
              </span>
            </div>

            <div class="prose">
              <Content />
            </div>
          </section>
        )}

        <section
          id="evidence-register"
          class="record-section"
          aria-labelledby="evidence-heading"
        >
          <div class="section-topline">
            <span class="eyebrow">
              [ SOURCE REGISTER ]
            </span>
            <span class="section-code">
              EVIDENCE.LOG
            </span>
          </div>

          <h2 id="evidence-heading">
            Evidence register<span class="accent-blue">.</span>
          </h2>

          {hasEvidence ? (
            <div class="evidence-list">
              {data.evidence.map((item, index) => (
                <div
                  class="evidence-card"
                  id={`evidence-${item.id}`}
                >
                  <div class="evidence-topline">
                    <span>
                      EV-{String(index + 1).padStart(2, "0")}
                    </span>

                    <span>
                      {evidenceLabels[item.type]}
                    </span>
                  </div>

                  <h3>{item.id}</h3>
                  <p>{item.description}</p>

                  <dl>
                    <div>
                      <dt>SOURCE</dt>
                      <dd>
                        {item.source.startsWith("https://") ||
                        item.source.startsWith("http://") ? (
                          <a
                            href={item.source}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {item.source}
                          </a>
                        ) : (
                          item.source
                        )}
                      </dd>
                    </div>

                    {item.collectedAt && (
                      <div>
                        <dt>COLLECTED</dt>
                        <dd>
                          {formatDate(item.collectedAt)}
                        </dd>
                      </div>
                    )}

                    {item.sha256 && (
                      <div>
                        <dt>SHA-256</dt>
                        <dd class="hash">
                          {item.sha256}
                        </dd>
                      </div>
                    )}
                  </dl>

                  {item.limitations.length > 0 && (
                    <div class="evidence-limitations">
                      <h4>ITEM LIMITATIONS</h4>

                      <ul>
                        {item.limitations.map(
                          (limitation) => (
                            <li>{limitation}</li>
                          )
                        )}
                      </ul>
                    </div>
                  )}
                </div>
              ))}
            </div>
          ) : (
            <p class="record-empty">
              No individual evidence items are registered
              for this record. This does not imply that
              supporting evidence has been collected.
            </p>
          )}
        </section>

        <section
          id="findings"
          class="record-section"
          aria-labelledby="findings-heading"
        >
          <div class="section-topline">
            <span class="eyebrow">
              [ ANALYTICAL RESULTS ]
            </span>
            <span class="section-code">
              FINDINGS.LOG
            </span>
          </div>

          <h2 id="findings-heading">
            Findings<span class="accent-green">.</span>
          </h2>

          {hasStructuredFindings ? (
            <div class="findings-list">
              {data.findings.map((finding, index) => (
                <section class="finding-card">
                  <div class="finding-topline">
                    <span>
                      FINDING-{String(index + 1).padStart(2, "0")}
                    </span>

                    <span
                      class={`confidence-${finding.confidence}`}
                    >
                      CONFIDENCE / {finding.confidence.toUpperCase()}
                    </span>
                  </div>

                  <h3>{finding.title}</h3>
                  <p>{finding.summary}</p>

                  <div class="finding-evidence">
                    <span>SUPPORTING EVIDENCE</span>

                    {finding.evidenceIds.length > 0 ? (
                      <div class="finding-links">
                        {finding.evidenceIds
                          .filter((id) => evidenceIds.has(id))
                          .map((id) => (
                            <a href={`#evidence-${id}`}>
                              {id}
                            </a>
                          ))}
                      </div>
                    ) : (
                      <span class="no-evidence">
                        NO EVIDENCE ITEMS LINKED
                      </span>
                    )}
                  </div>

                  {finding.limitations.length > 0 && (
                    <div class="finding-limitations">
                      <h4>FINDING LIMITATIONS</h4>

                      <ul>
                        {finding.limitations.map(
                          (limitation) => (
                            <li>{limitation}</li>
                          )
                        )}
                      </ul>
                    </div>
                  )}
                </section>
              ))}
            </div>
          ) : (
            <p class="record-empty">
              No structured findings have been registered.
              The research status and technical narrative
              should not be interpreted as verified results.
            </p>
          )}
        </section>

        <section
          id="limitations"
          class="record-section"
          aria-labelledby="limitations-heading"
        >
          <div class="section-topline">
            <span class="eyebrow">
              [ INTERPRETATION BOUNDARIES ]
            </span>
            <span class="section-code">
              SCOPE.LIMITS
            </span>
          </div>

          <h2 id="limitations-heading">
            Limitations<span class="accent-blue">.</span>
          </h2>

          {data.methodology.limitations.length > 0 ? (
            <ul class="limitations-list">
              {data.methodology.limitations.map(
                (limitation) => (
                  <li>{limitation}</li>
                )
              )}
            </ul>
          ) : (
            <p class="record-empty">
              No overarching methodological limitations
              have been recorded in the structured metadata.
            </p>
          )}
        </section>

        <section
          id="references"
          class="record-section"
          aria-labelledby="references-heading"
        >
          <div class="section-topline">
            <span class="eyebrow">
              [ SOURCE MATERIAL ]
            </span>
            <span class="section-code">
              REFERENCES
            </span>
          </div>

          <h2 id="references-heading">
            References<span class="accent-green">.</span>
          </h2>

          {data.references.length > 0 ? (
            <ol class="references-list">
              {data.references.map((reference) => (
                <li>
                  <a
                    href={reference.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {reference.label}
                    <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <p class="record-empty">
              No external references are listed
              for this record.
            </p>
          )}
        </section>

        {hasRelated && (
          <section class="record-section related-section">
            <div class="section-topline">
              <span class="eyebrow">
                [ CONTINUE INVESTIGATING ]
              </span>
              <span class="section-code">
                RELATED.RECORDS
              </span>
            </div>

            <h2>
              Related records<span class="accent-blue">.</span>
            </h2>

            <div class="related-grid">
              {relatedRecords.map((item) => (
                <a
                  class="related-card"
                  href={item.href}
                >
                  <span>{item.type}</span>

                  <strong>{item.title}</strong>

                  <small>{item.status}</small>
                </a>
              ))}
            </div>
          </section>
        )}

        <footer class="article-footer">
          <span>
            NULL SECTOR / RESEARCH / {entry.id.toUpperCase()}
          </span>

          <a href="/research/">
            ← BACK TO RESEARCH ARCHIVE
          </a>
        </footer>
      </article>
    </div>
  </main>
</BaseLayout>

<script>
  function initResearchArticle() {
    const article = document.querySelector<HTMLElement>(
      ".research-article"
    );

    if (!article) return;

    /*
     * Prevent duplicate event listeners when the page
     * is initialised through Astro navigation.
     */
    if (article.dataset.navigationReady === "true") {
      return;
    }

    article.dataset.navigationReady = "true";

    const links = Array.from(
      article.querySelectorAll<HTMLAnchorElement>(
        "[data-chapter-link]"
      )
    );

    const mobileSelect =
      article.querySelector<HTMLSelectElement>(
        "#mobile-chapter-select"
      );

    const sections = links
      .map((link) => {
        const id = link.hash.slice(1);
        const element = document.getElementById(id);

        return element ? { id, element } : null;
      })
      .filter(
        (
          item
        ): item is {
          id: string;
          element: HTMLElement;
        } => item !== null
      );

    if (!sections.length) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    let activeId = "";
    let frame = 0;

    function setActive(id: string) {
      if (!sections.some((section) => section.id === id)) {
        return;
      }

      if (activeId === id) return;

      activeId = id;

      links.forEach((link) => {
        const isActive = link.hash === `#${id}`;

        link.classList.toggle(
          "is-active",
          isActive
        );

        if (isActive) {
          link.setAttribute(
            "aria-current",
            "location"
          );
        } else {
          link.removeAttribute("aria-current");
        }
      });

      if (mobileSelect) {
        mobileSelect.value = id;
      }
    }

    /*
     * Determine the active chapter from document position.
     *
     * This is more predictable than relying on whichever
     * heading happens to intersect a narrow observer band.
     */
    function updateActiveFromScroll() {
      frame = 0;

      const activationOffset = Math.min(
        180,
        window.innerHeight * 0.25
      );

      let currentId = sections[0].id;

      for (const section of sections) {
        const top =
          section.element.getBoundingClientRect().top;

        if (top <= activationOffset) {
          currentId = section.id;
        } else {
          break;
        }
      }

      setActive(currentId);
    }

    function scheduleUpdate() {
      if (frame) return;

      frame = window.requestAnimationFrame(
        updateActiveFromScroll
      );
    }

    function goToSection(id: string) {
      const target = document.getElementById(id);

      if (!target) return;

      setActive(id);

      target.scrollIntoView({
        behavior: reducedMotion.matches
          ? "auto"
          : "smooth",
        block: "start",
      });

      history.replaceState(
        null,
        "",
        `#${encodeURIComponent(id)}`
      );
    }

    mobileSelect?.addEventListener(
      "change",
      () => {
        if (!mobileSelect.value) return;

        goToSection(mobileSelect.value);
      }
    );

    links.forEach((link) => {
      link.addEventListener("click", () => {
        const id = link.hash.slice(1);
        setActive(id);
      });
    });

    window.addEventListener(
      "scroll",
      scheduleUpdate,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      scheduleUpdate,
      { passive: true }
    );

    window.addEventListener(
      "hashchange",
      () => {
        const id = decodeURIComponent(
          window.location.hash.slice(1)
        );

        if (
          sections.some(
            (section) => section.id === id
          )
        ) {
          setActive(id);
        }

        scheduleUpdate();
      }
    );

    const initialId = decodeURIComponent(
      window.location.hash.slice(1)
    );

    if (
      initialId &&
      sections.some(
        (section) => section.id === initialId
      )
    ) {
      setActive(initialId);
    } else {
      setActive(sections[0].id);
    }

    /*
     * Check the actual scroll position after layout.
     * This also handles browser-restored scroll positions.
     */
    scheduleUpdate();
  }

  document.addEventListener(
    "astro:page-load",
    initResearchArticle
  );

  if (document.readyState === "loading") {
    document.addEventListener(
      "DOMContentLoaded",
      initResearchArticle,
      { once: true }
    );
  } else {
    initResearchArticle();
  }
</script>

<style>
  .research-article {
    background: var(--bg);
  }

  .article-hero {
    padding: clamp(3rem, 6vw, 6rem) 0;
    border-bottom: 1px solid var(--border);
  }

  .hero-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .back-link,
  .system-label,
  .record-label,
  .topic-tag,
  .panel-header,
  .panel-footer,
  .metadata-list dt,
  .metadata-list dd {
    font-family: var(--font-mono);
  }

  .back-link {
    color: var(--green);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--text);
  }

  .system-label {
    color: var(--text-dim);
    font-size: 0.65rem;
    letter-spacing: 0.05em;
  }

  .hero-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 1.35fr)
      minmax(270px, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 5vw, 6rem);
  }

  .record-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 1.5rem;
    color: var(--blue);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
  }

  .record-square,
  .sidebar-square {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    background: var(--green);
  }

  .record-separator {
    color: var(--text-dim);
  }

  .hero-main h1 {
    max-width: 900px;
    margin-bottom: 1.5rem;
    font-family: var(--font-mono);
    font-size: clamp(2.6rem, 5.5vw, 5rem);
    letter-spacing: -0.075em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .hero-description {
    max-width: 720px;
    margin-bottom: 1.5rem;
