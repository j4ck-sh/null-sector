            <a href={withBase("/field-notes/satellite-orbital-data-basics/")}>
              Satellite Orbital Data: Reading the Basics
              <span aria-hidden="true">↗</span>
            </a>

            <small>TLE STRUCTURE / MEAN MOTION / EPOCHS / SGP4</small>
          </div>

          <a class="home-inline-link" href={withBase("/field-notes/")}>
            OPEN FIELD NOTES
            <span aria-hidden="true">↗</span>
