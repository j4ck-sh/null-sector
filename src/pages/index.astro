    href: withBase("/field-notes/"), action: "OPEN FIELD NOTES",
  },
  {
    id: "about", label: "ABOUT", code: "NS", x: 78, y: 77,
    title: "About NULL SECTOR",
    description: "The purpose of this independent archive, its areas of interest, and its approach to documenting evidence.",
    href: withBase("/about/"), action: "READ ABOUT",
  },
];

const navigationItems = [
  { label: "Home", group: "PAGE", href: withBase("/"), keywords: "home start" },
  {
    label: "Learning archive",
    group: "PAGE",
    href: withBase("/learning/"),
    keywords: "courses training",
  },
  {
    label: "Research archive",
    group: "PAGE",
    href: withBase("/research/"),
    keywords: "investigations osint",
  },
  {
    label: "Field Notes",
    group: "PAGE",
    href: withBase("/field-notes/"),
    keywords: "notes reference",
  },
  {
    label: "About NULL SECTOR",
    group: "PAGE",
    href: withBase("/about/"),
    keywords: "about profile",
  },
  ...learningHighlights.map((item) => ({
    label: item.title,
    group: "LEARNING",
    href: item.href,
    keywords: `${item.provider} ${item.type}`,
  })),
  {
    label: "Satellite OSINT: Public Orbital Data",
    group: "RESEARCH",
    href: withBase("/research/satellite-osint-methodology/"),
    keywords: "iss satellite orbital celestrak",
  },
  {
    label: "Satellite Orbital Data: Reading the Basics",
    group: "FIELD NOTE",
    href: withBase("/field-notes/satellite-orbital-data-basics/"),
    keywords: "tle sgp4 epoch mean motion",
  },
];



---

<BaseLayout
  title="NULL SECTOR | Cybersecurity & Digital Forensics"
  description="NULL SECTOR is an independent cybersecurity and digital-forensics portfolio documenting learning, technical research, and field notes with clear evidence boundaries."
>
  <main id="main-content" class="home-page">
    <!-- HERO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-layout">
        <div class="hero-copy">
          <div class="hero-meta">
            <span class="signal-square" aria-hidden="true"></span>
            <span>INDEPENDENT TECHNICAL ARCHIVE</span>
            <span class="accent-green" aria-hidden="true">/</span>
            <span>EST. 2026</span>
          </div>

          <p class="hero-path">
            <span>root@nullsector</span>:~$ ./explore
            <span class="cursor-block" aria-hidden="true"></span>
          </p>

          <h1 id="hero-title">
            NULL<span class="accent-green">_</span><br />
            SECTOR<span class="accent-blue">.</span>
          </h1>

          <p class="hero-lead">
            Investigating digital systems.<br />
            Documenting what I learn.
          </p>

          <p class="hero-description">
            An independent space for cybersecurity, digital forensics,
            technical learning, and evidence-led research. Exploring
            systems from satellite infrastructure to malware and
            incident response.
          </p>

          <div class="hero-actions">
            <a class="home-button" href={withBase("/research/")}>
              <span aria-hidden="true">[→]</span>
              EXPLORE RESEARCH
            </a>

            <a class="home-button secondary" href={withBase("/learning/")}>
              VIEW LEARNING
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <button
            class="palette-shortcut"
            type="button"
            data-open-palette
            aria-haspopup="dialog"
          >
            <span class="shortcut-icon" aria-hidden="true">⌘</span>
            SEARCH THE ARCHIVE
            <kbd>CTRL / ⌘ + K</kbd>
          </button>

          <div class="hero-bottom-line" aria-hidden="true">
            <span class="short-line"></span>
            SCROLL TO EXPLORE
            <span class="accent-green">↓</span>
          </div>
        </div>

        <div class="hero-visual" id="signal-scanner">
          <div class="panel-bar">
            <span>NS // SIGNAL SCANNER</span>
            <span class="panel-active"><span class="signal-square" aria-hidden="true"></span> 04 SIGNALS</span>
          </div>

          <div class="pixel-field" id="pixel-field">
            <canvas id="pixel-canvas" aria-hidden="true"></canvas>
            <div class="field-center" aria-hidden="true">
              <span class="field-axis"></span>
              <div class="field-emblem"><span>N</span><span>S</span></div>
              <span class="field-axis"></span>
            </div>
            {
              scannerSignals.map((signal, index) => (
                <button
                  type="button"
                  class:list={["scanner-beacon", { "is-active": index === 0 }]}
                  style={`--signal-x:${signal.x}%;--signal-y:${signal.y}%;`}
                  data-signal={signal.id}
                  aria-pressed={index === 0 ? "true" : "false"}
                  aria-label={`Inspect ${signal.label}`}
                >
                  <span class="scanner-beacon-icon" aria-hidden="true">{signal.code}</span>
                  <span class="scanner-beacon-label">{signal.label}</span>
                </button>
              ))
            }
            <span class="field-coordinate field-coordinate-top" aria-hidden="true">SIGNALS / 04</span>
            <span class="field-coordinate field-coordinate-bottom" aria-hidden="true">SELECT TO INSPECT</span>
          </div>

          <div class="scanner-readout" aria-live="polite" aria-atomic="true">
            <div class="scanner-readout-heading"><span>DETECTED / <span data-signal-index>01</span></span><span data-signal-status>LEARNING</span></div>
            <h2 data-signal-title>{scannerSignals[0].title}</h2>
            <p data-signal-description>{scannerSignals[0].description}</p>
            <a class="scanner-readout-link" data-signal-link href={scannerSignals[0].href}>
              <span data-signal-action>{scannerSignals[0].action}</span><span aria-hidden="true">↗</span>
            </a>
            <div class="scanner-related" data-signal-related hidden>
              <span>CONNECTED SATELLITE RECORDS</span>
              <a href={withBase("/learning/satellite-cybersecurity/")}>Satellite cybersecurity learning ↗</a>
              <a href={withBase("/field-notes/satellite-orbital-data-basics/")}>Orbital-data reference note ↗</a>
            </div>
          </div>
          <div class="panel-bar panel-bar-bottom">
            <span>SELECT A LABELED SIGNAL / KEYBOARD ACCESSIBLE</span>
            <span>CONTENT INDEX</span>
          </div>
        </div>
      </div>

      <div class="hero-edge-label" aria-hidden="true">
        NS—001 / OBSERVE · ANALYSE · DOCUMENT
      </div>
    </section>

    <!-- LEARNING -->
    <section
      class="home-section learning-section"
      aria-labelledby="learning-title"
    >
      <div class="container">
        <div class="section-topline">
          <span class="section-eyebrow">[ 01 / LEARNING ]</span>
          <span class="section-code">KNOWLEDGE.LOG</span>
        </div>

        <div class="section-intro">
          <h2 id="learning-title">
            Always <span class="accent-green">learning.</span>
          </h2>
          <p>
            A record of completed training, coursework, and technical
            development. Course completion and professional
            certification are distinguished explicitly.
          </p>
        </div>

        <div class="learning-grid">
          {
            learningHighlights.map((item) => (
              <a class="learning-entry" href={item.href}>
                <div class="learning-entry-top">
                  <span>{item.index} / {item.type}</span>
                  <span class="entry-status">
                    <span class="signal-square" aria-hidden="true"></span>
                    {item.status}
                  </span>
                </div>

                <div class="learning-entry-body">
                  <span class="entry-provider">{item.provider}</span>
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>

                <div class="entry-footer">
                  <span>READ LEARNING RECORD</span>
                  <span aria-hidden="true">↗</span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="section-end">
          <span class="section-end-line"></span>
          <a class="home-inline-link" href={withBase("/learning/")}>
            VIEW LEARNING ARCHIVE <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FEATURED RESEARCH / ORBITAL VISUAL -->
    <section
      class="home-section orbital-section"
      aria-labelledby="featured-title"
    >
      <div class="container">
        <div class="section-topline">
          <span class="section-eyebrow blue">
            [ 02 / FEATURED RESEARCH ]
          </span>
          <span class="section-code">ORBITAL.DATA / REFERENCE</span>
        </div>

        <div class="orbital-layout">
          <div class="orbital-copy">
            <div class="featured-meta">
              <span>SPACE SYSTEMS / SATELLITE OSINT</span>
              <span>PUBLIC-SOURCE RESEARCH</span>
            </div>

            <h2 id="featured-title">
              Satellite OSINT:
              <span class="accent-blue">
                public orbital data.
              </span>
            </h2>

            <p class="orbital-description">
              A source-based examination of historical ISS orbital
              information, including mean motion, a derived approximate
              period, provenance, and the limits of what public data
              can establish.
            </p>

            <div class="orbital-metric">
              <span>HISTORICAL MEAN MOTION</span>
              <strong>15.49535659</strong>
              <small>REVOLUTIONS / DAY</small>
            </div>

            <a
              class="home-button"
              href={withBase("/research/satellite-osint-methodology/")}
            >
              READ THE RESEARCH
              <span aria-hidden="true">↗</span>
            </a>
          </div>

          <div class="orbit-module" id="orbit-module">
            <div class="panel-bar">
              <span>ORBITAL / EXPLAINER</span>
              <span class="accent-blue">ILLUSTRATIVE</span>
            </div>

            <div class="orbit-stage">
              <svg
                class="orbit-svg"
                viewBox="0 0 500 400"
                role="img"
                aria-label="Illustrative orbital path surrounding a stylized Earth; not a live satellite position"
              >
                <defs>
                  <radialGradient id="earth-shading">
                    <stop offset="0%" stop-color="#203d43" />
                    <stop offset="75%" stop-color="#11272c" />
                    <stop offset="100%" stop-color="#09191d" />
                  </radialGradient>
                </defs>

                <g class="orbit-grid-svg">
                  {
                    Array.from({ length: 11 }, (_, index) => (
                      <line
                        x1={index * 50}
                        y1="0"
                        x2={index * 50}
                        y2="400"
                      />
                    ))
                  }
                  {
                    Array.from({ length: 9 }, (_, index) => (
                      <line
                        x1="0"
                        y1={index * 50}
                        x2="500"
                        y2={index * 50}
                      />
                    ))
                  }
                </g>

                <line
                  class="orbit-axis"
                  x1="250"
                  y1="0"
                  x2="250"
                  y2="400"
                />
                <line
                  class="orbit-axis"
                  x1="0"
                  y1="200"
                  x2="500"
                  y2="200"
                />

                <circle
                  class="orbit-outer-guide"
                  cx="250"
                  cy="200"
                  r="165"
                />

                <g class="orbit-earth">
                  <circle
                    cx="250"
                    cy="200"
                    r="92"
                    fill="url(#earth-shading)"
                    stroke="#4c8992"
                    stroke-width="1.5"
                  />
                  <ellipse
                    cx="250"
                    cy="200"
                    rx="35"
                    ry="92"
                    fill="none"
                    stroke="#4c8992"
                    stroke-opacity=".4"
                  />
                  <ellipse
                    cx="250"
                    cy="200"
                    rx="72"
                    ry="92"
                    fill="none"
                    stroke="#4c8992"
                    stroke-opacity=".2"
                  />
                  <path
                    d="M158 200H342 M170 155H330 M170 245H330"
                    stroke="#4c8992"
                    stroke-opacity=".3"
                    fill="none"
                  />
                  <path
                    d="M218 138l18-11 24 8 9 21-12 16-22 3-11 23-25-9-9-26z"
                    fill="#609a88"
                    fill-opacity=".32"
                  />
                  <path
                    d="M265 217l23-5 19 16-7 30-20 24-16-9-7-31z"
                    fill="#609a88"
                    fill-opacity=".28"
                  />
                </g>

                <g
                  class="orbit-track"
                  transform="rotate(-27 250 200)"
                >
                  <ellipse
                    cx="250"
                    cy="200"
                    rx="205"
                    ry="122"
                    fill="none"
                    stroke="#83c4d0"
                    stroke-width="1.5"
                    stroke-dasharray="6 7"
                  />

                  <g class="orbit-satellite">
                    <rect
                      x="445"
                      y="190"
                      width="20"
                      height="20"
                      fill="#b1e8bd"
                    />
                    <rect
                      x="429"
                      y="194"
                      width="12"
                      height="12"
                      fill="#7bb6c3"
                    />
                    <rect
                      x="469"
                      y="194"
                      width="12"
                      height="12"
                      fill="#7bb6c3"
                    />
                    <line
                      x1="441"
                      y1="200"
                      x2="469"
                      y2="200"
                      stroke="#b1e8bd"
                      stroke-width="2"
                    />
                  </g>
                </g>

                <text x="18" y="28" class="orbit-svg-label">
                  REF / ISS
                </text>
                <text x="18" y="382" class="orbit-svg-label">
                  NOT TO SCALE
                </text>
                <text
                  x="482"
                  y="382"
                  text-anchor="end"
                  class="orbit-svg-label"
                >
                  NO LIVE POSITION
                </text>
              </svg>
            </div>

            <div class="orbit-controls">
              {
                orbitalModes.map((mode, index) => (
                  <button
                    type="button"
                    class:list={[
                      "orbit-mode",
                      { "is-active": index === 0 },
                    ]}
                    data-orbit-mode={mode.id}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    {mode.label}
                  </button>
                ))
              }
            </div>

            <div
              class="orbit-readout"
              aria-live="polite"
              aria-atomic="true"
            >
              <span data-orbit-title>
                {orbitalModes[0].title}
              </span>
              <strong data-orbit-value>
                {orbitalModes[0].value}
              </strong>
              <p data-orbit-description>
                {orbitalModes[0].description}
              </p>
            </div>

            <div class="orbit-disclaimer">
              ILLUSTRATIVE VISUALIZATION / NOT LIVE TRACKING /
              NO SGP4 PROPAGATION
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- INVESTIGATION NETWORK -->
    <section
      class="home-section network-section"
      aria-labelledby="research-title"
    >
      <div class="container">
        <div class="section-topline">
          <span class="section-eyebrow blue">
            [ 03 / RESEARCH DOMAINS ]
          </span>
          <span class="section-code">INVESTIGATION.MAP</span>
        </div>

        <div class="section-intro">
          <h2 id="research-title">
            Areas of
            <span class="accent-blue"> investigation.</span>
          </h2>
          <p>
            Eight connected areas of study. Select a node to explore
            its focus and discover whether related work has been
            published. Connections are thematic, not measured data.
          </p>
        </div>

        <div class="network-layout" id="research-network">
          <div class="network-panel">
            <div class="panel-bar">
              <span>DOMAIN RELATIONSHIPS</span>
              <span>08 NODES</span>
            </div>

            <div class="network-canvas">
              <svg
                class="network-lines"
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                {
                  [
                    [0, 1],
                    [0, 7],
                    [0, 6],
                    [1, 2],
                    [1, 3],
                    [2, 3],
                    [2, 7],
                    [3, 4],
                    [3, 6],
                    [4, 5],
                    [4, 7],
                    [5, 6],
                    [5, 7],
                    [6, 7],
                  ].map(([start, end]) => (
                    <line
                      x1={researchAreas[start].x}
                      y1={researchAreas[start].y}
                      x2={researchAreas[end].x}
                      y2={researchAreas[end].y}
                    />
                  ))
                }
              </svg>

              <div class="network-center" aria-hidden="true">
                <span>NS</span>
                <small>DOMAIN INDEX</small>
              </div>

              {
                researchAreas.map((area, index) => (
                  <button
                    type="button"
                    class:list={[
                      "network-node",
                      { "is-active": index === 0 },
                    ]}
                    style={`--node-x:${area.x}%;--node-y:${area.y}%;`}
                    data-network-node={area.number}
                    aria-label={`Explore ${area.title}`}
                    aria-pressed={index === 0 ? "true" : "false"}
                    title={area.title}
                  >
                    <span class="node-symbol">{area.symbol}</span>
                    <span class="node-number">{area.number}</span>
                  </button>
                ))
              }
            </div>

            <div class="network-footer">
              <span>SELECT A NODE TO INSPECT</span>
              <span>CONCEPTUAL CONNECTIONS</span>
            </div>
          </div>

          <div class="network-inspector">
            <div class="inspector-header">
              <span>NODE INSPECTOR</span>
              <span data-node-number>01 / 08</span>
            </div>

            <div class="inspector-content" aria-live="polite">
              <span class="inspector-category" data-node-category>
                {researchAreas[0].category}
              </span>

              <h3 data-node-title>{researchAreas[0].title}</h3>

              <p data-node-description>
                {researchAreas[0].description}
              </p>

              <div class="inspector-status">
                <span>CONTENT STATUS</span>
                <strong data-node-status>
                  {researchAreas[0].related}
                </strong>
              </div>

              <a
                class="inspector-link"
                data-node-link
                href={researchAreas[0].href}
              >
                VIEW RELATED WORK
                <span aria-hidden="true">↗</span>
              </a>
            </div>

            <div class="inspector-bottom">
              SELECTABLE TOPICS / NOT A RECORD OF EIGHT
              COMPLETED INVESTIGATIONS
            </div>
          </div>
        </div>

        <div class="research-topic-index">
          {
            researchAreas.map((area) => (
              <button
                type="button"
                class:list={[
                  "topic-button",
                  { "is-active": area.number === "01" },
                ]}
                data-topic-select={area.number}
                aria-pressed={area.number === "01" ? "true" : "false"}
              >
                <span>{area.number}</span>
                {area.title}
