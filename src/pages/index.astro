
---
import BaseLayout from "../layouts/BaseLayout.astro";

const basePath = import.meta.env.BASE_URL;

function withBase(path: string): string {
  const base = basePath.endsWith("/")
    ? basePath
    : `${basePath}/`;

  return `${base}${path.replace(/^\/+/, "")}`;
}


const learningHighlights = [
  {
    index: "01",
    title: "Security Analyst Level 1",
    provider: "TRYHACKME",
    type: "TRAINING PATH",
    status: "TRAINING COMPLETED",
    description:
      "Completed the SAL1 training material covering security operations and investigation workflows. Preparing for the certification examination; certification has not been earned.",
    href: withBase("/learning/tryhackme-sal1/"),
  },
  {
    index: "02",
    title: "MalDev Academy",
    provider: "MALDEV ACADEMY",
    type: "COURSE COMPLETION",
    status: "COMPLETED",
    description:
      "Completed all main modules of the malware-development course and received its course completion certificate.",
    href: withBase("/learning/maldev-academy/"),
  },
  {
    index: "03",
    title: "Satellite Cybersecurity Foundations",
    provider: "UDEMY / ANGELINA TSUBOI",
    type: "COURSE COMPLETION",
    status: "COMPLETED",
    description:
      "Completed the course covering satellite systems and security fundamentals, including an instructor-guided Hack the Orbit walkthrough.",
    href: withBase("/learning/satellite-cybersecurity/"),
  },
];

const researchAreas = [
  {
    number: "01",
    title: "Satellite Security",
    category: "SPACE SYSTEMS",
    symbol: "SAT",
    description:
      "Spacecraft architecture, orbital information, ground infrastructure, and communications security.",
    x: 50,
    y: 16,
    related: "PUBLISHED RESEARCH",
    href: withBase("/research/satellite-osint-methodology/"),
  },
  {
    number: "02",
    title: "Drone Forensics",
    category: "UNCREWED SYSTEMS",
    symbol: "UAV",
    description:
      "Flight records, controllers, navigation artifacts, firmware, and digital evidence.",
    x: 77,
    y: 29,
    related: "AREA OF INTEREST",
    href: "",
  },
  {
    number: "03",
    title: "Mobile Forensics",
    category: "MOBILE SYSTEMS",
    symbol: "MOB",
    description:
      "Mobile-device artifacts, application data, timelines, and investigative methods.",
    x: 84,
    y: 65,
    related: "AREA OF INTEREST",
    href: "",
  },
  {
    number: "04",
    title: "IoT Forensics",
    category: "EMBEDDED SYSTEMS",
    symbol: "IOT",
    description:
      "Connected devices, firmware, network activity, and embedded-system evidence.",
    x: 58,
    y: 83,
    related: "AREA OF INTEREST",
    href: "",
  },
  {
    number: "05",
    title: "Vehicle Security",
    category: "AUTOMOTIVE",
    symbol: "CAN",
    description:
      "Automotive networks, embedded controllers, and vehicle-related forensic questions.",
    x: 28,
    y: 78,
    related: "AREA OF INTEREST",
    href: "",
  },
  {
    number: "06",
    title: "Ethical Hacking",
    category: "OFFENSIVE SECURITY",
    symbol: "SEC",
    description:
      "Authorised security testing, vulnerability concepts, and defensive understanding.",
    x: 16,
    y: 46,
    related: "AREA OF INTEREST",
    href: "",
  },
  {
    number: "07",
    title: "Malware Analysis",
    category: "REVERSE ENGINEERING",
    symbol: "HEX",
    description:
      "Malicious-code behaviour, operating-system internals, and forensic artifacts.",
    x: 28,
    y: 20,
    related: "RELATED LEARNING",
    href: withBase("/learning/maldev-academy/"),
  },
  {
    number: "08",
    title: "Incident Response",
    category: "DEFENSIVE SECURITY",
    symbol: "IR",
    description:
      "Alert triage, log correlation, network evidence, and incident investigation.",
    x: 49,
    y: 49,
    related: "RELATED LEARNING",
    href: withBase("/learning/tryhackme-sal1/"),
  },
];

const orbitalModes = [
  {
    id: "period",
    label: "01 / PERIOD",
    title: "Approximate orbital period",
    value: "92.93 MIN",
    description:
      "A historical published mean-motion value of 15.49535659 revolutions per day gives an approximate orbital period of 92.93 minutes.",
  },
  {
    id: "source",
    label: "02 / PROVENANCE",
    title: "Public-source provenance",
    value: "HISTORICAL DATA",
    description:
      "The cited orbital information originated with CelesTrak and was reproduced in a ByteTools technical reference. This portfolio did not independently capture the dataset.",
  },
  {
    id: "limits",
    label: "03 / LIMITS",
    title: "What this display represents",
    value: "ILLUSTRATIVE",
    description:
      "This is a stylized educational diagram, not a real-time ISS position, SGP4 propagation result, orbital reconstruction, or satellite-security test.",
  },
];

const scannerSignals = [
  {
    id: "learning", label: "LEARNING", code: "LRN", x: 22, y: 25,
    title: "Learning archive",
    description: "Three documented training and course-completion records, with credentials and limitations stated clearly.",
    href: withBase("/learning/"), action: "OPEN LEARNING",
  },
  {
    id: "research", label: "RESEARCH", code: "RSH", x: 78, y: 24,
    title: "Research archive",
    description: "Public-source satellite OSINT research, including historical orbital-data provenance and evidence boundaries.",
    href: withBase("/research/"), action: "OPEN RESEARCH",
  },
  {
    id: "notes", label: "FIELD NOTES", code: "NOT", x: 23, y: 77,
    title: "Field Notes",
