<script>
  const basePath = import.meta.env.BASE_URL;

  function withBase(path: string): string {
    const base = basePath.endsWith("/") ? basePath : `${basePath}/`;
    return `${base}${path.replace(/^\/+/, "")}`;
  }

  const scannerSignals = [
    { id: "learning", label: "LEARNING", title: "Learning archive", description: "Three documented training and course-completion records, with credentials and limitations stated clearly.", href: withBase("/learning/"), action: "OPEN LEARNING" },
    { id: "research", label: "RESEARCH", title: "Research archive", description: "Public-source satellite OSINT research, including historical orbital-data provenance and evidence boundaries.", href: withBase("/research/"), action: "OPEN RESEARCH" },
    { id: "notes", label: "FIELD NOTES", title: "Field Notes", description: "Focused technical references, beginning with TLE structure, mean motion, epochs, and SGP4 concepts.", href: withBase("/field-notes/"), action: "OPEN FIELD NOTES" },
    { id: "about", label: "ABOUT", title: "About NULL SECTOR", description: "The purpose of this independent archive, its areas of interest, and its approach to documenting evidence.", href: withBase("/about/"), action: "READ ABOUT" },
  ];

  const researchAreas = [
    {
      number: "01",
      title: "Satellite Security",
      category: "SPACE SYSTEMS",
      description:
        "Spacecraft architecture, orbital information, ground infrastructure, and communications security.",
      related: "PUBLISHED RESEARCH",
      href: withBase("/research/satellite-osint-methodology/"),
    },
    {
      number: "02",
      title: "Drone Forensics",
      category: "UNCREWED SYSTEMS",
      description:
        "Flight records, controllers, navigation artifacts, firmware, and digital evidence.",
      related: "AREA OF INTEREST",
      href: "",
    },
    {
      number: "03",
      title: "Mobile Forensics",
      category: "MOBILE SYSTEMS",
      description:
        "Mobile-device artifacts, application data, timelines, and investigative methods.",
      related: "AREA OF INTEREST",
      href: "",
    },
    {
      number: "04",
      title: "IoT Forensics",
      category: "EMBEDDED SYSTEMS",
      description:
        "Connected devices, firmware, network activity, and embedded-system evidence.",
      related: "AREA OF INTEREST",
      href: "",
    },
    {
      number: "05",
      title: "Vehicle Security",
      category: "AUTOMOTIVE",
      description:
        "Automotive networks, embedded controllers, and vehicle-related forensic questions.",
      related: "AREA OF INTEREST",
      href: "",
    },
    {
      number: "06",
      title: "Ethical Hacking",
      category: "OFFENSIVE SECURITY",
      description:
        "Authorised security testing, vulnerability concepts, and defensive understanding.",
      related: "AREA OF INTEREST",
      href: "",
    },
    {
      number: "07",
      title: "Malware Analysis",
      category: "REVERSE ENGINEERING",
      description:
        "Malicious-code behaviour, operating-system internals, and forensic artifacts.",
      related: "RELATED LEARNING",
      href: withBase("/learning/maldev-academy/"),
    },
    {
      number: "08",
      title: "Incident Response",
      category: "DEFENSIVE SECURITY",
      description:
        "Alert triage, log correlation, network evidence, and incident investigation.",
      related: "RELATED LEARNING",
      href: withBase("/learning/tryhackme-sal1/"),
    },
  ];

  const orbitalModes = [
    {
      id: "period",
      title: "Approximate orbital period",
      value: "92.93 MIN",
      description:
        "A historical published mean-motion value of 15.49535659 revolutions per day gives an approximate orbital period of 92.93 minutes.",
    },
    {
      id: "source",
      title: "Public-source provenance",
      value: "HISTORICAL DATA",
      description:
        "The cited orbital information originated with CelesTrak and was reproduced in a ByteTools technical reference. This portfolio did not independently capture the dataset.",
    },
    {
      id: "limits",
      title: "What this display represents",
      value: "ILLUSTRATIVE",
      description:
        "This is a stylized educational diagram, not a real-time ISS position, SGP4 propagation result, orbital reconstruction, or satellite-security test.",
    },
  ];

  function initHomepage() {
    const root = document.querySelector<HTMLElement>(".home-page");

    if (!root || root.dataset.initialized === "true") return;

    root.dataset.initialized = "true";

    const cleanup: Array<() => void> = [];

    const listen = <K extends keyof DocumentEventMap>(
      target: Document,
      event: K,
      handler: (event: DocumentEventMap[K]) => void
    ) => {
      target.addEventListener(event, handler);
      cleanup.push(() => target.removeEventListener(event, handler));
    };

    // Signal scanner: navigation, not another archive listing.
    const scanner = document.querySelector<HTMLElement>("#signal-scanner");
    if (scanner) {
      const beacons = Array.from(scanner.querySelectorAll<HTMLButtonElement>("[data-signal]"));
      const title = scanner.querySelector<HTMLElement>("[data-signal-title]");
      const description = scanner.querySelector<HTMLElement>("[data-signal-description]");
      const index = scanner.querySelector<HTMLElement>("[data-signal-index]");
      const status = scanner.querySelector<HTMLElement>("[data-signal-status]");
      const link = scanner.querySelector<HTMLAnchorElement>("[data-signal-link]");
      const action = scanner.querySelector<HTMLElement>("[data-signal-action]");
      const related = scanner.querySelector<HTMLElement>("[data-signal-related]");

      function selectSignal(id: string) {
        const selectedIndex = scannerSignals.findIndex((signal) => signal.id === id);
        const signal = scannerSignals[selectedIndex];
        if (!signal || !title || !description || !index || !status || !link || !action || !related) return;
        title.textContent = signal.title;
        description.textContent = signal.description;
        index.textContent = String(selectedIndex + 1).padStart(2, "0");
        status.textContent = signal.label;
        link.href = signal.href;
        action.textContent = signal.action;
        related.hidden = id !== "research";
        beacons.forEach((beacon) => {
          const active = beacon.dataset.signal === id;
          beacon.classList.toggle("is-active", active);
          beacon.setAttribute("aria-pressed", String(active));
        });
        scanner?.querySelector("#pixel-field")?.dispatchEvent(
  new CustomEvent("signal:select", { detail: { id } })
);
      }

      beacons.forEach((beacon) => {
        const handler = () => selectSignal(beacon.dataset.signal ?? "");
        beacon.addEventListener("click", handler);
        cleanup.push(() => beacon.removeEventListener("click", handler));
      });
    }

    // Orbital annotation controls
    const orbitModule = document.querySelector<HTMLElement>(
      "#orbit-module"
    );

    if (orbitModule) {
      const buttons = Array.from(
        orbitModule.querySelectorAll<HTMLButtonElement>(
          "[data-orbit-mode]"
        )
      );

      const title = orbitModule.querySelector<HTMLElement>(
        "[data-orbit-title]"
      );
      const value = orbitModule.querySelector<HTMLElement>(
        "[data-orbit-value]"
      );
      const description = orbitModule.querySelector<HTMLElement>(
        "[data-orbit-description]"
      );

      function selectOrbitMode(id: string) {
        const mode = orbitalModes.find(
          (entry) => entry.id === id
        );

        if (!mode || !title || !value || !description) return;

        title.textContent = mode.title;
        value.textContent = mode.value;
        description.textContent = mode.description;

        buttons.forEach((button) => {
          const active = button.dataset.orbitMode === id;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        });
      }

      buttons.forEach((button) => {
        const handler = () => {
          selectOrbitMode(button.dataset.orbitMode ?? "");
        };

        button.addEventListener("click", handler);
        cleanup.push(() =>
          button.removeEventListener("click", handler)
        );
      });
    }

    // Research network
    const network = document.querySelector<HTMLElement>(
      "#research-network"
    );

    if (network) {
      const nodeButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-network-node]"
        )
      );

      const topicButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>(
          "[data-topic-select]"
        )
      );

      const number = network.querySelector<HTMLElement>(
        "[data-node-number]"
      );
      const category = network.querySelector<HTMLElement>(
        "[data-node-category]"
      );
      const title = network.querySelector<HTMLElement>(
        "[data-node-title]"
      );
      const description = network.querySelector<HTMLElement>(
        "[data-node-description]"
      );
      const status = network.querySelector<HTMLElement>(
        "[data-node-status]"
      );
      const link = network.querySelector<HTMLAnchorElement>(
        "[data-node-link]"
      );

      function selectNode(id: string) {
        const area = researchAreas.find(
          (entry) => entry.number === id
        );

        if (
          !area ||
          !number ||
          !category ||
          !title ||
          !description ||
          !status ||
          !link
        ) {
          return;
        }

        number.textContent = `${area.number} / 08`;
        category.textContent = area.category;
        title.textContent = area.title;
        description.textContent = area.description;
        status.textContent = area.related;

        if (area.href) {
          link.href = area.href;
          link.hidden = false;
        } else {
          link.removeAttribute("href");
          link.hidden = true;
        }

        nodeButtons.forEach((button) => {
          const active = button.dataset.networkNode === id;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        });

        topicButtons.forEach((button) => {
          const active = button.dataset.topicSelect === id;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-pressed", String(active));
        });
      }

      const allButtons = [...nodeButtons, ...topicButtons];

      allButtons.forEach((button) => {
        const handler = () => {
          selectNode(
            button.dataset.networkNode ??
              button.dataset.topicSelect ??
              ""
          );
        };

        button.addEventListener("click", handler);
        cleanup.push(() =>
          button.removeEventListener("click", handler)
        );
      });
    }

    // Command palette
    const palette = document.querySelector<HTMLDialogElement>(
      "#command-palette"
    );
    const paletteInput = document.querySelector<HTMLInputElement>(
      "#palette-input"
    );
    const paletteEmpty = document.querySelector<HTMLElement>(
      "#palette-empty"
    );

    const paletteResults = Array.from(
      document.querySelectorAll<HTMLAnchorElement>(
        ".palette-result"
      )
    );

    let selectedResult = 0;

    function visibleResults() {
      return paletteResults.filter((item) => !item.hidden);
    }

    function highlightResult(index: number) {
      const visible = visibleResults();

      if (!visible.length) return;

      selectedResult =
        ((index % visible.length) + visible.length) %
        visible.length;

      paletteResults.forEach((item) => {
        item.classList.remove("is-selected");
      });

      const selected = visible[selectedResult];

      selected.classList.add("is-selected");
      selected.scrollIntoView({
        block: "nearest",
        behavior: "instant",
      });
    }

    function filterResults() {
      const query = paletteInput?.value
        .trim()
        .toLowerCase() ?? "";

      paletteResults.forEach((item) => {
        const searchable = item.dataset.searchLabel ?? "";
        item.hidden = !searchable.includes(query);
      });

      const visible = visibleResults();

      if (paletteEmpty) {
        paletteEmpty.hidden = visible.length > 0;
      }

      selectedResult = 0;

      if (visible.length) highlightResult(0);
    }

    function openPalette() {
      if (!palette || !paletteInput) return;

      if (!palette.open) palette.showModal();

      paletteInput.value = "";
      filterResults();
      paletteInput.focus();
    }

    function closePalette() {
      if (palette?.open) palette.close();
    }

    const openButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        "[data-open-palette]"
      )
    );

    const closeButton = document.querySelector<HTMLButtonElement>(
      "[data-close-palette]"
    );

    openButtons.forEach((button) => {
      button.addEventListener("click", openPalette);
      cleanup.push(() =>
        button.removeEventListener("click", openPalette)
      );
    });

    closeButton?.addEventListener("click", closePalette);
    cleanup.push(() =>
      closeButton?.removeEventListener("click", closePalette)
    );

    paletteInput?.addEventListener("input", filterResults);
    cleanup.push(() =>
      paletteInput?.removeEventListener("input", filterResults)
    );

    const handleKeys = (event: KeyboardEvent) => {
      const target = event.target;

      const isTyping =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement &&
          target.isContentEditable);

      if (
        (event.ctrlKey || event.metaKey) &&
        event.key.toLowerCase() === "k"
      ) {
        event.preventDefault();

        if (palette?.open) {
          closePalette();
        } else {
          openPalette();
        }

        return;
      }

      if (
        event.key === "/" &&
        !isTyping &&
        !event.altKey &&
        !event.ctrlKey &&
        !event.metaKey
      ) {
        event.preventDefault();
        openPalette();
        return;
      }

      if (!palette?.open) return;

      if (event.key === "ArrowDown") {
        event.preventDefault();
        highlightResult(selectedResult + 1);
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();
        highlightResult(selectedResult - 1);
      }

      if (event.key === "Enter") {
        const selected = visibleResults()[selectedResult];

        if (selected) {
          event.preventDefault();
          window.location.assign(selected.href);
        }
      }
    };

    listen(document, "keydown", handleKeys);

    // Signal-field canvas
    const canvas = document.querySelector<HTMLCanvasElement>(
      "#pixel-canvas"
    );
    const field = document.querySelector<HTMLElement>(
      "#pixel-field"
    );

    if (canvas && field) {
      initSignalField(canvas, field, cleanup);
    }

    function destroy() {
      cleanup.forEach((dispose) => dispose());
      root?.removeAttribute("data-initialized");
      document.removeEventListener("astro:before-swap", destroy);
    }

    document.addEventListener(
      "astro:before-swap",
      destroy,
      { once: true }
    );
  }

  function initSignalField(
    canvas: HTMLCanvasElement,
    field: HTMLElement,
    cleanup: Array<() => void>
  ) {
    const context = canvas.getContext("2d");

    if (!context) return;

    const motionQuery = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    );

    const cellSize = 16;

    let width = 0;
    let height = 0;
    let columns = 0;
    let rows = 0;
    let time = 0;
    let frame = 0;
    let visible = true;
    let destroyed = false;

    let pointerX = -1000;
    let pointerY = -1000;

    const pulses: Array<{
      x: number;
      y: number;
      age: number;
    }> = [];

    function resize() {
      if (destroyed) return;

      const bounds = field.getBoundingClientRect();

      width = bounds.width;
      height = bounds.height;

      if (width <= 0 || height <= 0) return;

      const ratio = Math.min(
        window.devicePixelRatio || 1,
        2
      );

      columns = Math.ceil(width / cellSize);
      rows = Math.ceil(height / cellSize);

      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);

      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      context!.setTransform(ratio, 0, 0, ratio, 0, 0);

      draw();
    }

    function draw() {
      if (destroyed || !width || !height) return;

      context!.clearRect(0, 0, width, height);

      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < columns; x++) {
          const px = x * cellSize + cellSize / 2;
          const py = y * cellSize + cellSize / 2;

          const distance = Math.hypot(
            px - pointerX,
            py - pointerY
          );

          const proximity = Math.max(
            0,
            1 - distance / 150
          );

          const wave =
            Math.sin(x * 0.38 + time * 0.018) *
            Math.cos(y * 0.35 + time * 0.013);

          let pulseIntensity = 0;

          pulses.forEach((pulse) => {
            const pulseDistance = Math.hypot(
              px - pulse.x,
              py - pulse.y
            );

            const radius = pulse.age * 5;

            pulseIntensity = Math.max(
              pulseIntensity,
              Math.max(
                0,
                1 - Math.abs(pulseDistance - radius) / 35
              ) *
                Math.max(0, 1 - pulse.age / 75)
            );
          });

          const opacity = Math.min(
            0.95,
            0.08 +
              Math.max(0, wave) * 0.12 +
              proximity * 0.65 +
              pulseIntensity * 0.65
          );

          const isBlue = (x + y * 3) % 7 === 0;

          context!.fillStyle = isBlue
            ? `rgba(120,183,194,${opacity})`
            : `rgba(145,213,165,${opacity})`;

          const size =
            proximity > 0.2 || pulseIntensity > 0.2
              ? 5
              : 3;

          context!.fillRect(
            px - size / 2,
            py - size / 2,
            size,
            size
          );
        }
      }

      pulses.forEach((pulse) => {
        const opacity = Math.max(
          0,
          0.5 * (1 - pulse.age / 75)
        );

        context!.strokeStyle =
          `rgba(120,183,194,${opacity})`;

        context!.lineWidth = 1;
        context!.beginPath();
        context!.arc(
          pulse.x,
          pulse.y,
          pulse.age * 5,
          0,
          Math.PI * 2
        );
        context!.stroke();
      });
    }

    function shouldAnimate() {
      return (
        !destroyed &&
        !motionQuery.matches &&
        visible &&
        !document.hidden
      );
    }

    function stop() {
      window.cancelAnimationFrame(frame);
      frame = 0;
    }

    function animate() {
      if (!shouldAnimate()) {
        frame = 0;
        return;
      }

      time += 1;

      pulses.forEach((pulse) => {
        pulse.age += 1;
      });

      for (let index = pulses.length - 1; index >= 0; index--) {
        if (pulses[index].age >= 75) {
          pulses.splice(index, 1);
        }
      }

      draw();
      frame = window.requestAnimationFrame(animate);
    }

    function restart() {
      stop();

      if (shouldAnimate()) {
        frame = window.requestAnimationFrame(animate);
      } else if (!destroyed) {
        draw();
      }
    }

    function pointerMove(event: PointerEvent) {
      const bounds = field.getBoundingClientRect();

      pointerX = event.clientX - bounds.left;
      pointerY = event.clientY - bounds.top;

      if (motionQuery.matches) draw();
    }

    function pointerLeave() {
      pointerX = -1000;
      pointerY = -1000;

      if (motionQuery.matches) draw();
    }

    function signalSelect(event: Event) {
      const id = (event as CustomEvent<{ id: string }>).detail?.id;
      const beacon = Array.from(field.querySelectorAll<HTMLElement>("[data-signal]"))
        .find((item) => item.dataset.signal === id);
      if (!beacon) return;
      const fieldBounds = field.getBoundingClientRect();
      const beaconBounds = beacon.getBoundingClientRect();
      const x = beaconBounds.left + beaconBounds.width / 2 - fieldBounds.left;
      const y = beaconBounds.top + beaconBounds.height / 2 - fieldBounds.top;
      pointerX = x;
      pointerY = y;
      if (!motionQuery.matches) {
        pulses.push({ x, y, age: 0 });
        if (pulses.length > 5) pulses.shift();
      } else {
        draw();
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        visible = entries[0]?.isIntersecting ?? false;
        restart();
      },
      { threshold: 0.05 }
    );

    const resizeObserver = new ResizeObserver(resize);

    observer.observe(field);
    resizeObserver.observe(field);

    field.addEventListener("pointermove", pointerMove, {
      passive: true,
    });
    field.addEventListener("pointerleave", pointerLeave);
    field.addEventListener("signal:select", signalSelect);

    document.addEventListener(
      "visibilitychange",
      restart
    );

    motionQuery.addEventListener("change", restart);

    cleanup.push(() => {
      destroyed = true;
      stop();

      observer.disconnect();
      resizeObserver.disconnect();

      field.removeEventListener(
        "pointermove",
        pointerMove
      );
      field.removeEventListener(
        "pointerleave",
        pointerLeave
      );
      field.removeEventListener("signal:select", signalSelect);

      document.removeEventListener(
        "visibilitychange",
        restart
      );

      motionQuery.removeEventListener(
        "change",
        restart
      );
    });

    resize();
    restart();
  }

