  <!-- COMMAND PALETTE -->
  <dialog
    class="command-palette"
    id="command-palette"
    aria-labelledby="palette-title"
  >
    <div class="palette-shell">
      <div class="palette-heading">
        <span id="palette-title">NULL SECTOR / QUICK ACCESS</span>
        <button
          type="button"
          class="palette-close"
          data-close-palette
          aria-label="Close command palette"
